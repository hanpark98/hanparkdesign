{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "ignoreCommand": "echo \"$VERCEL_GIT_COMMIT_REF\" | grep -q '^dependabot/'",
  "routes": [
    {
      "src": "/(.*)",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(GPTBot|ClaudeBot|anthropic-ai|CCBot|Bytespider|cohere-ai|Meta-ExternalAgent).*"
        }
      ],
      "mitigate": {
        "action": "deny"
      }
    }
  ],
