---
import type { ProjectRecommendations } from '../utils/projectRecommendations';

const { recommendations } = Astro.props as { recommendations: ProjectRecommendations };
const cards = [
  recommendations.related && {
    ...recommendations.related,
    label: 'Related project',
    type: 'related',
  },
  recommendations.discovery && {
    ...recommendations.discovery,
    label: 'Explore another direction',
    type: 'discovery',
  },
].filter(Boolean);
---

{cards.length > 0 && (
  <section class="project-recommendations muguhada-project-card mb-4 fade-section" aria-labelledby="other-projects-title">
    <div class="muguhada-project-divider">
      <h2 id="other-projects-title">Explore Other Projects</h2>
    </div>
    <div class="project-highlights-grid">
      {cards.map(card => card && (
        <a
          href={`/posts/${card.slug}`}
          class="project-highlight-item"
          aria-label={`${card.label}: ${card.title}`}
          data-analytics-project-card
          data-analytics-source="project_recommendations"
          data-recommendation-type={card.type}
          data-project={card.title}
          data-slug={card.slug}
          data-category={card.categories.join(',')}
        >
          <div class="project-highlight-image">
            <img
              src={card.image}
              alt={card.title}
              loading="lazy"
              style={card.thumbnailPosition ? `object-position: ${card.thumbnailPosition}` : undefined}
            />
            <div class="project-highlight-content">
              <div class="project-highlight-title" role="heading" aria-level="3">{card.title}</div>
              {card.description && <p class="project-highlight-description">{card.description}</p>}
            </div>
          </div>
        </a>
      ))}
    </div>
  </section>
)}

<style>
  .project-highlights-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
    margin: 0;
  }

  .project-highlight-item {
    position: relative;
    display: block;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: 10px;
    background: #e6e4de;
    box-shadow:
      0 0 0 0 rgba(116, 126, 137, 0),
      0 1px 5px rgba(17, 17, 17, 0.05);
    text-decoration: none;
    transform: translateZ(0);
    transition:
      box-shadow 0.32s cubic-bezier(0.22, 1, 0.36, 1),
      transform 0.18s cubic-bezier(0.22, 1, 0.36, 1),
      filter 0.18s ease;
  }

  .project-highlight-content {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 1.2rem;
    background: linear-gradient(
      to top,
      rgba(8, 12, 18, 0.86) 0%,
      rgba(8, 12, 18, 0.55) 15%,
      rgba(8, 12, 18, 0) 30%
    );
  }

  .project-highlight-title {
    margin: 0;
    color: #fff;
    font-size: 1.3rem;
    font-weight: 800;
    line-height: 1.25;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.35);
  }

  .project-highlight-description {
    display: -webkit-box;
    overflow: hidden;
    margin: 0 !important;
    color: rgba(255, 255, 255, 0.84);
    font-size: 1rem !important;
    line-height: 1.4 !important;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.35);
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .project-highlight-image {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
    background: #e6e4de;
  }

  .project-highlight-image img {
    width: 100%;
    height: 100%;
    margin: 0;
    object-fit: cover;
    transition: transform 0.28s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .project-highlight-item:active {
    filter: brightness(0.9);
    transform: scale(0.98);
  }

  .project-highlight-item:focus-visible {
    outline: 3px solid #5b74a3;
    outline-offset: 3px;
  }

  @media (hover: hover) {
    .project-highlight-item:hover {
      box-shadow:
        0 0 0 4px #5b74a3,
        0 24px 40px -14px rgba(17, 17, 17, 0.32);
    }

    .project-highlight-item:hover .project-highlight-image img {
      transform: scale(1.025);
    }
  }

  @media (min-width: 641px) {
    .project-highlights-grid {
      grid-template-columns: 1fr 1fr;
      gap: 24px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .project-highlight-item,
    .project-highlight-image img {
      transition: none;
    }
  }
</style>
