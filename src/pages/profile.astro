---
import Layout from '../layouts/Layout.astro';

const experience = [
  { year: '2026', org: 'Han Design', role: 'Graphic Designer' },
  { year: '2023–2025', org: 'Kijibae', orgSuffix: 'Gel Nail Strips', role: 'Graphic Designer' },
  { year: '2023–2025', org: 'BAZZAAL', orgSuffix: 'Marketing Agency', role: 'Graphic Designer' },
  { year: '2022', org: 'Daeki & Jun', orgSuffix: 'Design Studio', role: 'Assistant Designer' },
  { year: '2020–2022', org: 'Content Creator', role: '' },
  { year: '2018–2020', org: 'ROKA 1st Artillery Brigade', role: 'Assistant Publicist' },
  { year: '2018', org: 'YBM', role: 'Videographer' },
  { year: '2018', org: 'UNIVTOMORROW', role: 'Content Creator' },
  { year: '2017', org: 'RocketView', role: 'Marketing Strategy and Design' },
];

const awards = [
  { year: '2024', org: 'Graphis International Awards', role: 'Gold / Silver' },
  {
    year: '2023',
    org: 'Red Dot Design Awards',
    role: 'Winner / Brand & Communication',
    featured: true,
  },
  { year: '2023', org: 'The Society of Typographic Arts', role: 'STA 100' },
  { year: '2015', org: 'The Korean Society of Media & Arts', role: 'Honorable Mention' },
  { year: '2014', org: 'Seoul National Univ. of Sci & Tech', role: '2nd Prize / Character Design' },
];

// 같은 연도가 연속으로 이어지면 하나의 연도 그룹으로 묶기
function groupByYear(list) {
  const groups = [];
  for (const item of list) {
    const last = groups[groups.length - 1];
    if (last && last.year === item.year) {
      last.items.push(item);
    } else {
      groups.push({ year: item.year, items: [item] });
    }
  }
  return groups;
}

// "2023–2025" 형태의 범위를 [2025, 2024, 2023]처럼 연도별 한 줄씩으로 풀어서 표시
function yearLines(year) {
  const [a, b] = year.split('–').map(s => s.trim());
  if (!b) return [a];
  const start = parseInt(a, 10);
  const end = parseInt(b, 10);
  const lines = [];
  for (let y = end; y >= start; y--) lines.push(String(y));
  return lines;
}

const experienceGroups = groupByYear(experience);
const awardGroups = groupByYear(awards);
---

<Layout title="Profile">
  <div class="pt-[24px] bg-[#ebe9e5] min-h-screen">
    <div id="category-nav" class="flex flex-wrap gap-x-4 gap-y-2 mb-8 px-3 sm:px-6 justify-start items-center">
      <button
        onclick="window.history.back()"
        class="back-btn mr-6"
      >
        Return
      </button>
    </div>

    <!-- 프로필 카드 -->
    <div class="profile-card fade-section max-w-xl mx-auto my-8 bg-white rounded-[16px] overflow-hidden">
      <div class="profile-card-content text-center">
        <img src="/images/website/logo.svg" alt="Han Park" class="profile-logo-mark" />
        <div class="profile-name">Han Park<br />박한결</div>
        <div class="profile-title">Graphic Designer</div>

        <div class="profile-divider"></div>

        <blockquote class="profile-quote">
          Global-minded strategist with educational backgrounds from Canada, the UK, and South Korea, specialized in marketing and creative direction.
        </blockquote>
      </div>
    </div>

    <!-- Experience -->
    <div class="max-w-xl mx-auto mb-8 cv-section fade-section">
      <div class="cv-heading">Experience</div>
      <div class="cv-list">
        {experienceGroups.map(group => (
          <div class="cv-row">
            <div class="cv-year">
              {yearLines(group.year).map(y => <span class="cv-year-line">{y}</span>)}
            </div>
            <div class="cv-entries">
              {group.items.map(item => (
                <div class="cv-entry">
                  <div class="cv-thumb">
                    {item.thumb ? <img src={item.thumb} alt="" /> : <svg class="cv-thumb-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="3"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/></svg>}
                  </div>
                  <div class="cv-text">
                    <div class="cv-org">
                      {item.org}
                      {item.orgSuffix && <span class="cv-org-suffix">{item.orgSuffix}</span>}
                    </div>
                    {item.role && <div class="cv-role">{item.role}</div>}
                  </div>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Awards -->
    <div class="max-w-xl mx-auto mb-10 cv-section fade-section">
      <div class="cv-heading">Awards</div>
      <div class="cv-list">
        {awardGroups.map(group => (
          <div class="cv-row">
            <div class="cv-year">
              {yearLines(group.year).map(y => <span class="cv-year-line">{y}</span>)}
            </div>
            <div class="cv-entries">
              {group.items.map(item => (
                <div class="cv-entry-wrap">
                  <div class="cv-entry">
                    <div class="cv-thumb">
                      {item.thumb ? <img src={item.thumb} alt="" /> : <svg class="cv-thumb-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="3"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/></svg>}
                    </div>
                    <div class="cv-text">
                      <div class="cv-org">{item.org}</div>
                      {item.role && <div class="cv-role">{item.role}</div>}
                    </div>
                  </div>
                  {item.featured && (
                    <div class="cv-feature">
                      {item.description && <p class="cv-feature-desc">{item.description}</p>}
                      <div class="cv-feature-image">
                        {item.image
                          ? <img src={item.image} alt="" />
                          : <svg class="cv-feature-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2"><rect x="2" y="2" width="20" height="20" rx="2"/><circle cx="8" cy="8" r="1.6"/><path d="M22 16l-6-6-10 10"/></svg>}
                      </div>
                    </div>
                  )}
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- 연락처 -->
    <div class="max-w-xl mx-auto mb-16 cv-section fade-section">
      <div class="cv-heading">Contact</div>
      <div class="contact-list">
        <a href="mailto:hanparkdesign@gmail.com" class="contact-row" id="email-contact" data-email="hanparkdesign@gmail.com">
          <span class="contact-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/></svg>
          </span>
          <span class="contact-text" id="email-contact-text">hanparkdesign@gmail.com</span>
        </a>
        <a href="https://www.instagram.com/hanparkdesign/" target="_blank" rel="noopener noreferrer" class="contact-row">
          <span class="contact-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.2" cy="6.8" r="0.6" fill="currentColor" stroke="none"/></svg>
          </span>
          <span class="contact-text">@hanparkdesign</span>
        </a>
      </div>
    </div>
  </div>

  <script>
    // 스크롤로 뷰포트에 들어오는 섹션을 아래→위로 fade in — 나갔다 다시 들어올 때마다 매번 재생
    const fadeSections = document.querySelectorAll('.fade-section');
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          entry.target.classList.toggle('is-visible', entry.isIntersecting);
        });
      }, { threshold: 0.15, rootMargin: '0px 0px -40px 0px' });
      fadeSections.forEach((section) => io.observe(section));
    } else {
      fadeSections.forEach((section) => section.classList.add('is-visible'));
    }

    const emailLink = document.getElementById('email-contact');
    const emailText = document.getElementById('email-contact-text');
    if (emailLink && emailText) {
      const original = emailText.textContent;
      emailLink.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(emailLink.dataset.email);
          emailText.textContent = 'Copied!';
          setTimeout(() => { emailText.textContent = original; }, 1600);
        } catch (e) {
          // 클립보드 API를 쓸 수 없으면 mailto 이동만 진행
        }
      });
    }
  </script>

  <style>
    /* 뒤로가기 버튼 */
    .back-btn {
      flex-shrink: 0;
      padding: .55rem 1.6rem .25rem;
      border-radius: 6px;
      background: #fff;
      color: #111;
      font-weight: 700;
      white-space: nowrap;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      text-align: center;
      border: none;
      cursor: pointer;
      box-shadow: 0 1px 2px rgba(17, 17, 17, 0.05);
      transition: background 0.2s ease, transform 0.15s ease, box-shadow 0.15s ease;
    }
    /* 호버 시 살짝 뜨는 피드백 */
    .back-btn:hover {
      transform: translateY(-2px);
      box-shadow: 0 4px 8px rgba(17, 17, 17, 0.1);
    }
    /* 클릭 시 살짝 눌리는 피드백 */
    .back-btn:active {
      transform: translateY(1px);
      box-shadow: 0 1px 2px rgba(17, 17, 17, 0.05);
    }

    body, html {
      background: #ebe9e5 !important;
    }

    .profile-card {
      border: 1px solid rgba(0, 0, 0, 0.06);
      box-shadow: 0px 0px 10px rgba(0, 0, 0, 0.02);
    }

    /* 스크롤로 뷰포트에 들어오면 아래→위로 fade in — posts 페이지 카드와 같은 패턴,
       나갔다 다시 들어올 때마다 매번 재생 */
    .fade-section {
      opacity: 0;
      transform: translateY(28px);
      transition: opacity 0.7s cubic-bezier(0.22, 1, 0.36, 1),
                  transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);
    }
    .fade-section.is-visible {
      opacity: 1;
      transform: translateY(0);
    }

    /* 실제 얼굴 사진 대신 이름 위에 검정 브랜드 마크만 작게 — 위아래 여백 동일하게.
       global.css의 img{margin-top/bottom:0 !important} 규칙이 margin-bottom을
       무시시켜서, 아래 여백은 margin 대신 padding-bottom으로 줌 */
    .profile-logo-mark {
      width: 78px;
      height: 78px;
      margin: 0 auto;
      padding-bottom: 32px;
      box-sizing: content-box;
      display: block;
    }

    .profile-card-content {
      padding: 2rem 2rem 2rem;
    }

    .profile-name {
      font-size: 1.55rem;
      font-weight: 700;
      letter-spacing: -0.02em;
      line-height: 1.3;
      color: #111;
    }

    .profile-title {
      margin-top: 6px;
      font-size: 1rem;
      font-weight: 600;
      letter-spacing: -0.01em;
      color: #9a9a9a;
    }

    .profile-divider {
      width: 40px;
      height: 2px;
      background: #111;
      margin: 20px auto 0;
    }

    .profile-quote {
      margin: 20px auto 0;
      max-width: 26rem;
      font-size: 1.05rem;
      letter-spacing: -0.01em;
      line-height: 1.7;
      color: #555;
    }

    @media (max-width: 640px) {
      .profile-card {
        margin-inline: 12px;
      }
      /* 위(패딩) = 로고 아래(패딩) 동일하게 유지 */
      .profile-card-content {
        padding: 1.5rem 1.25rem 1.5rem;
      }
      .profile-logo-mark {
        padding-bottom: 24px;
      }
    }

    /* ------------ Experience / Awards : 에디토리얼 리스트 ------------ */
    .cv-section {
      background: #fff;
      border-radius: 16px;
      padding: 28px 28px 6px;
      box-shadow: 0px 0px 10px rgba(0, 0, 0, 0.02);
    }

    .cv-heading {
      font-size: 1.2rem;
      font-weight: 800;
      letter-spacing: -0.02em;
      line-height: 1;
      text-transform: uppercase;
      color: #111;
      padding-bottom: 20px;
      margin-bottom: 8px;
      border-bottom: 1px solid rgba(17, 17, 17, 0.15);
    }

    /* 한 행 안의 연도 칸과 항목 칸 높이가 서로 달라도(연도 여러 줄, 항목 여러 개 등)
       항상 같은 규칙으로 중앙 정렬되도록 고정 */
    .cv-row {
      display: grid;
      grid-template-columns: 52px 1fr;
      column-gap: 20px;
      align-items: center;
      padding: 22px 0;
      border-bottom: 1px solid rgba(0, 0, 0, 0.07);
    }
    .cv-row:last-child {
      border-bottom: none;
      padding-bottom: 22px;
    }

    /* 연도 범위를 하나로 압축하지 않고 연도별 한 줄씩(2025 / 2024 / 2023) 나열 */
    .cv-year {
      min-width: 0;
    }
    .cv-year-line {
      display: block;
      font-variant-numeric: tabular-nums;
      font-weight: 700;
      font-size: 1rem;
      letter-spacing: -0.01em;
      color: #333;
      line-height: 1.5;
    }

    .cv-entries {
      display: flex;
      flex-direction: column;
      gap: 16px;
      min-width: 0;
    }

    .cv-entry {
      display: flex;
      align-items: center;
      gap: 12px;
      min-width: 0;
    }

    /* 썸네일 높이를 옆 텍스트 2줄(org + role) 높이에 맞춤 */
    .cv-thumb {
      flex: 0 0 auto;
      width: 46px;
      height: 46px;
      border-radius: 8px;
      background: #e6e4de;
      border: 1px solid rgba(0, 0, 0, 0.07);
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
    }
    .cv-thumb img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    .cv-thumb-icon {
      width: 18px;
      height: 18px;
      color: #b3b0a8;
    }

    .cv-text {
      min-width: 0;
    }

    .cv-org {
      font-weight: 700;
      font-size: 1.08rem;
      letter-spacing: -0.01em;
      color: #111;
      line-height: 1.35;
    }
    .cv-org-suffix {
      font-weight: 400;
      margin-left: 6px;
    }

    .cv-role {
      font-size: 0.92rem;
      letter-spacing: -0.01em;
      color: #8a8a8a;
      line-height: 1.35;
      margin-top: 2px;
    }

    /* Red Dot Design Awards의 설명 / 작업물 이미지 (별도 카드 없이 리스트 흐름 그대로) */
    .cv-feature {
      margin-top: 12px;
    }
    .cv-feature-desc {
      font-size: 0.86rem !important;
      font-weight: 400 !important;
      color: #5c5c5c;
      line-height: 1.6 !important;
      letter-spacing: normal !important;
      margin: 0 0 12px !important;
    }
    .cv-feature-image {
      width: 100%;
      aspect-ratio: 16 / 9;
      border-radius: 10px;
      background: #e6e4de;
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
    }
    .cv-feature-image img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    .cv-feature-icon {
      width: 36px;
      height: 36px;
      color: #b3b0a8;
    }

    @media (max-width: 640px) {
      .cv-section { margin-inline: 12px; padding: 28px 20px 4px; }
      .cv-row { grid-template-columns: 44px 1fr; column-gap: 14px; }
    }

    /* ------------ 연락처 ------------ */
    .contact-list {
      display: flex;
      flex-direction: column;
    }

    .contact-row {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 22px 0;
      border-bottom: 1px solid rgba(0, 0, 0, 0.07);
      color: #111;
      text-decoration: none;
    }
    .contact-row:last-child {
      border-bottom: none;
      padding-bottom: 22px;
    }

    .contact-icon {
      flex: 0 0 auto;
      width: 36px;
      height: 36px;
      border-radius: 8px;
      background: #e6e4de;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #6b6b6b;
    }
    .contact-icon svg {
      width: 16px;
      height: 16px;
    }

    .contact-text {
      font-weight: 600;
      font-size: 1.02rem;
      letter-spacing: -0.01em;
    }
  </style>
</Layout>
