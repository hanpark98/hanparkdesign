---
import Layout from '../layouts/Layout.astro';
import { personId, siteData } from '../data/site';

const experience = [
  // MUGUHADA 관련 정보 일시적으로 숨김 처리 — 나중에 다시 켤 수 있게 남겨둠
  // { year: '2027', org: 'MUGUHADA', role: 'Head of Design / Co-Founder', url: 'https://www.muguhada.com' },
  { year: '2026', org: 'Han Design', role: 'Graphic Designer' },
  { year: '2023–2025', org: 'Kijibae', orgSuffix: 'DIY Nails', role: 'Graphic Designer', url: 'https://www.shopkijibae.com' },
  { year: '2023–2025', org: 'BAZZAAL', orgSuffix: 'Marketing Agency', role: 'Graphic Designer', url: 'https://www.bazzaal.com/' },
  { year: '2022', org: 'Daeki & Jun', orgSuffix: 'Design Studio', role: 'Assistant Designer' },
  { year: '2020–2022', org: 'Content Creator', role: '' },
  { year: '2018–2020', org: 'ROKA 1st Artillery Brigade', role: 'Assistant Publicist' },
  { year: '2018', org: 'YBM', role: 'Videographer', url: 'https://www.ybmedu.com/e4u' },
  { year: '2018', org: 'UNIVTOMORROW', role: 'Content Creator', url: 'https://www.univ20.com/' },
  { year: '2017', org: 'RocketView', role: 'Marketing Strategy and Design' },
];

const education = [
  {
    year: '2014–2022',
    org: 'Seoul National University of Science and Technology',
    role: "Bachelor's degree, Design",
    dateRange: 'Mar 2014 – Feb 2022',
    grade: '3.54 / 4.5',
    activities: [
      '2014–2018 · Founder / Leader of LGBTQ+ Rights Club "큰따옴표"',
      '2014–2017 · Member of Visual Design Academia "Inacoms"',
    ],
    url: 'https://en.seoultech.ac.kr/',
  },
  { org: 'Cathays Highschool', role: 'Wales, United Kingdom', url: 'https://www.cathayshigh.co.uk/' },
  { org: 'Pinawa Elementary School', role: 'Manitoba, Canada' },
];

const awards = [
  { year: '2024', org: 'Graphis International Awards', role: 'Gold / Silver', url: 'https://graphis.com/competition/design-awards-2024/winners' },
  {
    year: '2023',
    org: 'Red Dot Design Awards',
    role: 'Winner — Brand & Communication',
    featured: true,
    url: 'https://www.red-dot.org/project/2022-gangwon-design-festa-gdf-66101',
  },
  { year: '2023', org: 'The Society of Typographic Arts', role: 'STA 100', url: 'https://typographicarts.org/' },
  { year: '2015', org: 'The Korean Society of Media & Arts', role: 'Honorable Mention', url: 'https://kos-ma.org/' },
  { year: '2014', org: 'Seoul National Univ. of Sci & Tech', role: '2nd Prize — Character Design', url: 'https://www.seoultech.ac.kr/service/board/rec/?do=commonview&searchtext=%EC%BA%90%EB%A6%AD%ED%84%B0&searchtype=1&nowpage=2&bnum=6302&bidx=183625&qidx=6302&cate=10&allboard=false&nowpage=2' },
];

// 같은 연도가 연속으로 이어지면 하나의 연도 그룹으로 묶기
function groupByYear(list) {
  const groups = [];
  for (const item of list) {
    const last = groups[groups.length - 1];
    if (last && last.year === item.year) {
      last.items.push(item);
    } else {
      groups.push({ year: item.year, items: [item] });
    }
  }
  return groups;
}

// "2023–2025" 형태의 범위를 [2025, 2024, 2023]처럼 연도별 한 줄씩으로 풀어서 표시
// 긴 기관명이 모바일에서 못생기게 줄바꿈되는 걸 막기 위한 지정 줄바꿈 지점 (PC에서는 한 줄 유지)
const orgLineBreaks = {
  'The Society of Typographic Arts': ['The Society of', 'Typographic Arts'],
  'The Korean Society of Media & Arts': ['The Korean Society of', 'Media & Arts'],
  'Seoul National Univ. of Sci & Tech': ['Seoul National Univ.', 'of Sci & Tech'],
  'Seoul National University of Science and Technology': ['Seoul National University', 'of Science and Technology'],
};

function yearLines(year) {
  const [a, b] = year.split('–').map(s => s.trim());
  if (!b) return [a];
  const start = parseInt(a, 10);
  const end = parseInt(b, 10);
  const lines = [];
  for (let y = end; y >= start; y--) lines.push(String(y));
  return lines;
}

const experienceGroups = groupByYear(experience);
const awardGroups = groupByYear(awards);
---

<Layout
  title={`${siteData.name} | Profile`}
  description={siteData.description}
  schema={{
    '@type': 'ProfilePage',
    '@id': `${siteData.url}/profile/#profile`,
    name: `${siteData.name} — ${siteData.jobTitle}`,
    url: `${siteData.url}/profile/`,
    mainEntity: { '@id': personId },
  }}
>
  <div class="pt-3 sm:pt-0 lg:pt-4 lg:relative bg-[#ebe9e5] min-h-screen">
    <!-- lg+: 버튼을 플로우에서 빼서 왼쪽 여백에 절대 위치시키고, 프로필 카드와 같은 높이(lg:top-4 = 위 wrapper의 lg:pt-4와 동일 기준점)에 맞춤 -->
    <div id="category-nav" class="flex flex-wrap gap-x-4 gap-y-2 mb-3 px-3 sm:px-6 lg:mb-0 lg:px-0 lg:absolute lg:top-4 lg:left-6 justify-start items-center">
      <button
        onclick="window.history.back()"
        class="back-btn mr-6"
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5"/><path d="M11 18l-6-6 6-6"/></svg>
        Back
      </button>
    </div>

    <!-- 프로필 카드 -->
    <div class="profile-card fade-section max-w-xl mx-auto mb-4 bg-white rounded-[16px] overflow-hidden">
      <div class="profile-card-content text-center">
        <img src="/images/website/logo.svg" alt={siteData.name} class="profile-logo-mark" />
        <div class="profile-name">{siteData.name}<br />{siteData.alternateName}</div>
        <div class="profile-title">{siteData.jobTitle}</div>
        <div class="profile-location">Based in {siteData.location.city}, {siteData.location.country} (GMT+9)</div>

        <div class="profile-divider"></div>

        <blockquote class="profile-quote">
          {siteData.taglineLead}<br />{siteData.taglineDetail}
        </blockquote>
      </div>
    </div>

    <!-- 연락처 -->
    <div class="max-w-xl mx-auto mb-4 cv-section fade-section">
      <div class="cv-heading">Contact</div>
      <div class="contact-list">
        <a href={siteData.linkedin} target="_blank" rel="noopener noreferrer" class="contact-row">
          <span class="contact-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="8.3" cy="8.3" r="0.7" fill="currentColor" stroke="none"/><path d="M8.3 10.8V17"/><path d="M12.5 17v-3.8"/><path d="M12.5 13.2c0-1.3 1-2.2 2.2-2.2s2.3.9 2.3 2.2V17"/></svg>
          </span>
          <span class="contact-text">hanparkdesign</span>
          <svg class="cv-external-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17L17 7"/><path d="M8 7h9v9"/></svg>
        </a>
        <a href={`mailto:${siteData.email}`} class="contact-row" id="email-contact" data-email={siteData.email}>
          <span class="contact-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/></svg>
          </span>
          <span class="contact-text" id="email-contact-text">{siteData.email}</span>
        </a>
      </div>
    </div>

    <!-- Skills & Tools -->
    <div class="max-w-xl mx-auto mb-4 cv-section fade-section">
      <div class="cv-heading">Skills & Tools</div>
      <div class="skills-list">
        <div class="skills-row">
          <div class="skills-category">Visual & Print</div>
          <div class="skills-tools">Adobe Photoshop, Illustrator, InDesign</div>
        </div>
        <div class="skills-row">
          <div class="skills-category">Motion & Video</div>
          <div class="skills-tools">Adobe After Effects, Premiere Pro</div>
        </div>
        <div class="skills-row">
          <div class="skills-category">Collaboration</div>
          <div class="skills-tools">Figma, Canva</div>
        </div>
        <div class="skills-row">
          <div class="skills-category">E-commerce & Performance Marketing</div>
          <div class="skills-tools">Shopify, Amazon, TikTok Shop, Meta Ads, Mailchimp</div>
        </div>
        <div class="skills-row">
          <div class="skills-category">Web</div>
          <div class="skills-tools">Visual Studio Code, AI Assistants</div>
        </div>
      </div>
    </div>

    <!-- Project Highlights -->
    <div class="max-w-xl mx-auto mb-4 cv-section fade-section">
      <div class="cv-heading">Project Highlights</div>
      <div class="highlights-grid">
        <a href="/posts/260322 Oliveyoung" class="highlight-item">
          <div class="skills-category">Olive Young</div>
          <div class="cv-feature-image client-thumb">
            <img src="/images/posts/260322 Oliveyoung/oliveyoung_thumb.webp" alt="Olive Young" />
          </div>
        </a>
        <a href="/posts/260331 Mediheal" class="highlight-item">
          <div class="skills-category">Mediheal</div>
          <div class="cv-feature-image client-thumb">
            <img src="/images/posts/260331 Mediheal/thumb2.webp" alt="Mediheal" />
          </div>
        </a>
        {/* VT Cosmetics, Bodhi Light International 일시적으로 숨김 — 나중에 다시 켤 수 있게 여기 남겨둠
        <a href="/posts/260215 VT cosmetics" class="highlight-item">
          <div class="skills-category">VT Cosmetics</div>
          <div class="cv-feature-image client-thumb">
            <img src="/images/posts/260215 VT cosmetics/thumb.webp" alt="VT Cosmetics" />
          </div>
        </a>
        <a href="/posts/260221 Relics" class="highlight-item">
          <div class="skills-category">Bodhi Light International</div>
          <div class="cv-feature-image client-thumb">
            <img src="/images/posts/260221 Relics/relic_thumb.webp" alt="Bodhi Light International" />
          </div>
        </a>
        */}
      </div>
    </div>

    <!-- Experience -->
    <div class="max-w-xl mx-auto mb-4 cv-section fade-section">
      <div class="cv-heading">Experience</div>
      <div class="cv-list">
        {experienceGroups.map(group => (
          <div class="cv-row">
            <div class="cv-year">
              {yearLines(group.year).map(y => <span class="cv-year-line">{y}</span>)}
            </div>
            <div class="cv-entries">
              {group.items.map(item => (
                item.url ? (
                  <a href={item.url} target="_blank" rel="noopener noreferrer" class="cv-entry cv-entry-link">
                    <div class="cv-thumb">
                      {item.thumb ? <img src={item.thumb} alt="" /> : <svg class="cv-thumb-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="3"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/></svg>}
                    </div>
                    <div class="cv-text">
                      <div class="cv-org">
                        {item.org}
                        {item.orgSuffix && <span class="cv-org-suffix">{item.orgSuffix}</span>}
                        <svg class="cv-external-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17L17 7"/><path d="M8 7h9v9"/></svg>
                      </div>
                      {item.role && <div class="cv-role">{item.role}</div>}
                    </div>
                  </a>
                ) : (
                  <div class="cv-entry">
                    <div class="cv-thumb">
                      {item.thumb ? <img src={item.thumb} alt="" /> : <svg class="cv-thumb-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="3"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/></svg>}
                    </div>
                    <div class="cv-text">
                      <div class="cv-org">
                        {item.org}
                        {item.orgSuffix && <span class="cv-org-suffix">{item.orgSuffix}</span>}
                      </div>
                      {item.role && <div class="cv-role">{item.role}</div>}
                    </div>
                  </div>
                )
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Awards -->
    <div class="max-w-xl mx-auto mb-4 cv-section fade-section">
      <div class="cv-heading">Awards</div>
      <div class="cv-list">
        {awardGroups.map(group => (
          <div class="cv-row">
            <div class="cv-year">
              {yearLines(group.year).map(y => <span class="cv-year-line">{y}</span>)}
            </div>
            <div class="cv-entries">
              {group.items.map(item => (
                <div class="cv-entry-wrap">
                  {item.url ? (
                    <a href={item.url} target="_blank" rel="noopener noreferrer" class="cv-entry cv-entry-link">
                      <div class="cv-thumb">
                        {item.thumb ? <img src={item.thumb} alt="" /> : <svg class="cv-thumb-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="3"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/></svg>}
                      </div>
                      <div class="cv-text">
                        <div class="cv-org">
                          {orgLineBreaks[item.org] ? (
                            <>{orgLineBreaks[item.org][0]}{' '}<br class="mobile-break" />{orgLineBreaks[item.org][1]}</>
                          ) : item.org}
                          <svg class="cv-external-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17L17 7"/><path d="M8 7h9v9"/></svg>
                        </div>
                        {item.role && <div class="cv-role">{item.role}</div>}
                      </div>
                    </a>
                  ) : (
                    <div class="cv-entry">
                      <div class="cv-thumb">
                        {item.thumb ? <img src={item.thumb} alt="" /> : <svg class="cv-thumb-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="3"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/></svg>}
                      </div>
                      <div class="cv-text">
                        <div class="cv-org">{item.org}</div>
                        {item.role && <div class="cv-role">{item.role}</div>}
                      </div>
                    </div>
                  )}
                  {item.featured && (
                    <div class="cv-feature">
                      {item.description && <p class="cv-feature-desc">{item.description}</p>}
                      <div class="cv-feature-image">
                        {item.image
                          ? <img src={item.image} alt="" />
                          : <svg class="cv-feature-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2"><rect x="2" y="2" width="20" height="20" rx="2"/><circle cx="8" cy="8" r="1.6"/><path d="M22 16l-6-6-10 10"/></svg>}
                      </div>
                    </div>
                  )}
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Education (연도 칼럼 없이 — 학교명/학위만 나열) -->
    <div class="max-w-xl mx-auto mb-4 cv-section fade-section">
      <div class="cv-heading">Education</div>
      <div class="cv-list">
        {education.map(item => (
          <div class="cv-row edu-row-flat">
            <div class="cv-entry-wrap">
              {item.url ? (
                <a href={item.url} target="_blank" rel="noopener noreferrer" class="cv-entry cv-entry-link">
                  <div class="cv-thumb">
                    {item.thumb ? <img src={item.thumb} alt="" /> : <svg class="cv-thumb-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="3"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/></svg>}
                  </div>
                  <div class="cv-text">
                    <div class="cv-org">
                      {orgLineBreaks[item.org] ? (
                        <>{orgLineBreaks[item.org][0]}{' '}<br class="mobile-break" />{orgLineBreaks[item.org][1]}</>
                      ) : item.org}
                      <svg class="cv-external-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17L17 7"/><path d="M8 7h9v9"/></svg>
                    </div>
                    {item.role && <div class="cv-role">{item.role}</div>}
                  </div>
                </a>
              ) : (
                <div class="cv-entry">
                  <div class="cv-thumb">
                    {item.thumb ? <img src={item.thumb} alt="" /> : <svg class="cv-thumb-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="3"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/></svg>}
                  </div>
                  <div class="cv-text">
                    <div class="cv-org">{item.org}</div>
                    {item.role && <div class="cv-role">{item.role}</div>}
                  </div>
                </div>
              )}
              {/* 연도·날짜/학점/활동 상세는 요청에 따라 화면에는 숨김 — 데이터는 그대로 두고 나중에 다시 켤 수 있게 함
              {(item.dateRange || item.grade || item.activities) && (
                <div class="cv-feature edu-feature">
                  {item.dateRange && <p class="edu-detail-line">{item.dateRange}</p>}
                  {item.grade && <p class="edu-detail-line">Grade: {item.grade}</p>}
                  {item.activities && (
                    <div class="edu-activities">
                      <div class="edu-activities-label">Activities and societies</div>
                      <ul class="edu-activities-list">
                        {item.activities.map(a => <li>{a}</li>)}
                      </ul>
                    </div>
                  )}
                </div>
              )}
              */}
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Languages -->
    <div class="max-w-xl mx-auto mb-4 cv-section fade-section">
      <div class="cv-heading">Languages</div>
      <div class="lang-list">
        <div class="lang-row">
          <div class="lang-name">English</div>
          <div class="lang-detail">
            <div class="lang-level">Professional Working Proficiency</div>
            {/* 취득일(Jan 2022), 어학 점수 모두 일시적으로 화면엔 숨김 — 나중에 다시 켤 수 있게 여기 남겨둠
            <div class="lang-score">TOEIC 955 · OPIc IH</div>
            */}
          </div>
        </div>
        <div class="lang-row">
          <div class="lang-name">Korean</div>
          <div class="lang-detail">
            <div class="lang-level">Native</div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script>
    // 스크롤로 뷰포트에 들어오는 섹션을 아래→위로 fade in — 나갔다 다시 들어올 때마다 매번 재생
    const fadeSections = document.querySelectorAll('.fade-section');
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          entry.target.classList.toggle('is-visible', entry.isIntersecting);
        });
      }, { threshold: 0.15, rootMargin: '0px 0px -40px 0px' });
      fadeSections.forEach((section) => io.observe(section));
    } else {
      fadeSections.forEach((section) => section.classList.add('is-visible'));
    }

    // navigator.clipboard는 HTTPS(보안 컨텍스트)에서만 동작하고 구형 모바일
    // 브라우저는 아예 없을 수도 있음 — 그런 경우 임시 textarea + execCommand로 폴백
    function copyToClipboard(text) {
      if (navigator.clipboard && navigator.clipboard.writeText && window.isSecureContext) {
        return navigator.clipboard.writeText(text);
      }
      return new Promise((resolve, reject) => {
        const textarea = document.createElement('textarea');
        textarea.value = text;
        textarea.style.position = 'fixed';
        textarea.style.top = '0';
        textarea.style.left = '0';
        textarea.style.opacity = '0';
        document.body.appendChild(textarea);
        textarea.focus();
        textarea.select();
        try {
          const ok = document.execCommand('copy');
          document.body.removeChild(textarea);
          ok ? resolve() : reject(new Error('execCommand copy failed'));
        } catch (err) {
          document.body.removeChild(textarea);
          reject(err);
        }
      });
    }

    const emailLink = document.getElementById('email-contact');
    const emailText = document.getElementById('email-contact-text');
    if (emailLink && emailText) {
      const original = emailText.textContent;
      emailLink.addEventListener('click', async (e) => {
        // 메일 앱으로 튕겨서 홈페이지를 이탈시키지 않도록 — 복사 피드백만 줌
        e.preventDefault();
        try {
          await copyToClipboard(emailLink.dataset.email);
          emailText.textContent = 'Copied!';
          setTimeout(() => { emailText.textContent = original; }, 1600);
        } catch (e) {
          // 복사조차 실패하면 최소한 이메일 주소가 선택된 채로 남게 됨 (기본 select 동작)
        }
      });
    }
  </script>

  <style>
    /* 뒤로가기 버튼 — 고스트 스타일, 박스 없이 아이콘+텍스트만, 호버 시 화살표가 슬라이드 */
    .back-btn {
      flex-shrink: 0;
      display: inline-flex; align-items: center; gap: 0.35rem;
      padding: 0.3rem 0.1rem;
      background: transparent; border: none;
      color: #111; font-weight: 600; font-size: 0.95rem;
      white-space: nowrap;
      cursor: pointer;
      transition: opacity 0.15s ease;
    }
