---
import Layout from '../layouts/Layout.astro';

// .md 파일 수집
const postFiles = Object.entries(import.meta.glob('../content/posts/*.md', { eager: true }));

// frontmatter + slug 파싱
const allPosts = postFiles.map(([p, f]) => ({
  slug: p.split('/').pop().replace('.md', ''),
  ...f.frontmatter
}));

// 배포 환경에서는 draft:true 또는 미래 날짜(post.date > today) 숨김
const isProd = import.meta.env.PROD;
const today = new Date();
const posts = allPosts
  .filter(p => {
    if (!isProd) return true; // dev에서는 전부 보이도록
    const isDraft = p.draft === true;
    const isFuture = p.date ? new Date(p.date) > today : false;
    return !isDraft && !isFuture;
  })
  .sort((a, b) => new Date(b.date ?? 0) - new Date(a.date ?? 0));

// 카테고리 정렬
const categoryOrder = ['버킷리스트', '에세이', '영화', '(Null)'];
const raw = [...new Set(posts.flatMap(p => Array.isArray(p.category) ? p.category : (p.category ? [p.category] : ['기타'])))];
const allCategories = [...categoryOrder.filter(c => raw.includes(c)), ...raw.filter(c => !categoryOrder.includes(c))];
---

<Layout title="Blog">
  <div class="pt-[24px] bg-[#ebe9e5] min-h-screen">

    <!-- 카테고리 Navigation -->
<div id="category-nav" class="flex items-center gap-0 px-3 sm:px-6 mb-0">
  <a href="/profile" class="profile-btn mr-6" data-category="profile">Profile</a>

  <div class="relative flex-1 sm:hidden">
    <select id="cat-select" class="w-full bg-white border border-gray-200 rounded-3xl px-4 pt-[10px] pb-[6px] font-bold text-[#111] appearance-none cursor-pointer outline-none">
      <option value="all">Every Projects</option>
      {allCategories.map(c => (
        <option value={c}>{c}</option>
      ))}
    </select>
    <div class="absolute right-3 top-1/2 -translate-y-1/2 pointer-events-none">
      <svg class="w-4 h-4 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
      </svg>
    </div>
  </div>

  <div id="cat-track"
       class="hidden sm:flex flex-nowrap overflow-x-auto gap-2 min-w-0 flex-1 -mr-6 pr-6 py-3 -my-3">
    <button class="category-btn active" data-category="all">Every Projects</button>
    {allCategories.map(c => (
      <button class="category-btn" data-category={c}>{c}</button>
    ))}
  </div>
</div>

    <!-- 포스트 목록 -->
    <div id="posts-wrapper" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6 px-3 sm:px-6 py-6">
      {posts.map(p => (
        <a href={`/posts/${p.slug}`} class="group post-card tilt-card"
           data-category={Array.isArray(p.category) ? p.category.join(',') : (p.category ?? '기타')}>
          <div class="w-full aspect-square overflow-hidden">
            <img src={p.image} alt={p.title}
                 class="tilt-card-thumb w-full h-full object-cover"/>
          </div>
          <div class="post-card-content">
            {p.date && <div class="post-card-date">{(new Date(p.date)).toLocaleDateString('ko-KR',{year:'numeric',month:'long',day:'numeric'})}</div>}
            <h3 class="post-card-title">{p.title}</h3>
            <p class="post-card-desc">{p.description}</p>
          </div>
        </a>
      ))}
    </div>
  </div>

  <!-- JS : 휠→가로 스크롤 & 필터 -->
<script>
  const btns   = document.querySelectorAll('.category-btn');
  const select = document.getElementById('cat-select');
  const cards  = document.querySelectorAll('.post-card');
  const track  = document.getElementById('cat-track');

  // 공통 필터링 함수
  function filterPosts(cat) {
    localStorage.setItem('lastCategory', cat);
    
    // 카드 표시/숨김 처리
    cards.forEach(c => {
      const isMatch = cat === 'all' || c.dataset.category.split(',').includes(cat);
      c.style.display = isMatch ? 'block' : 'none';
    });

    // 버튼 활성화 상태 동기화
    btns.forEach(b => {
      b.classList.toggle('active', b.dataset.category === cat);
    });

    // 드롭다운 값 동기화
    if (select) {
      select.value = cat;
    }
  }

  // 데스크톱 버튼 클릭 이벤트
  btns.forEach(b => b.addEventListener('click', () => filterPosts(b.dataset.category)));

  // 모바일 드롭다운 변경 이벤트 추가
  select?.addEventListener('change', (e) => filterPosts(e.target.value));

  // 기존 가로 스크롤 유지
  track?.addEventListener('wheel', e => {
    if (Math.abs(e.deltaY) > Math.abs(e.deltaX)) {
      e.preventDefault();
      track.scrollLeft += e.deltaY;
    }
  }, { passive:false });

  // 페이지 로드 시 상태 복원
  const last = localStorage.getItem('lastCategory') || 'all';
  filterPosts(last);

  // 스크롤로 뷰포트에 들어오는 카드를 아래→위로 fade in — 나갔다 다시 들어올 때마다 매번 재생
  if ('IntersectionObserver' in window) {
    const io = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        entry.target.classList.toggle('is-visible', entry.isIntersecting);
      });
    }, { threshold: 0.15, rootMargin: '0px 0px -40px 0px' });
    cards.forEach((card) => io.observe(card));
  } else {
    // 미지원 브라우저는 그냥 바로 보이게
    cards.forEach((card) => card.classList.add('is-visible'));
  }
</script>

  <style>
    /* 프로필 버튼 */
    .profile-btn {
      flex-shrink: 0;
      padding: .55rem 1.6rem .25rem;
      border-radius: 6px;
      background: #fff;
      color: #111;
      font-weight: 700;
      white-space: nowrap;
      box-shadow: 0 1px 2px rgba(17, 17, 17, 0.05);
      transition: transform 0.15s ease, box-shadow 0.15s ease;
    }
    /* 호버 시 살짝 뜨는 피드백 */
    .profile-btn:hover {
      transform: translateY(-2px);
      box-shadow: 0 4px 8px rgba(17, 17, 17, 0.1);
    }
    /* 클릭 시 살짝 눌리는 피드백 */
    .profile-btn:active {
      transform: translateY(1px);
      box-shadow: 0 1px 2px rgba(17, 17, 17, 0.05);
    }

    /* pill */
    .category-btn {
      flex-shrink: 0;
      min-width: 100px;
      max-width: 160px;
      padding: .57rem 1.3rem .27rem;
      border-radius: 9999px;
      background: #fff;
      color: #111;
      font-weight: 700;
      white-space: nowrap;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      text-align: center;
      box-shadow: 0 1px 2px rgba(17, 17, 17, 0.05);
      transition: background 0.2s ease, color 0.2s ease, transform 0.15s ease, box-shadow 0.15s ease;
    }

    /* 클릭 시(active) 색상 변경 */
.category-btn.active {
  background: #747e89; /* 기존 #009695에서 수정 */
  color: #fff;
}

    /* 호버 시 살짝 뜨는 피드백 */
    .category-btn:hover {
      transform: translateY(-2px);
      box-shadow: 0 4px 8px rgba(17, 17, 17, 0.1);
    }

    /* 마우스로 눌렀을 때 약간 눌린 듯한 피드백 */
    .category-btn:active {
      transform: translateY(1px);
      box-shadow: 0 1px 2px rgba(17, 17, 17, 0.05);
    }

    /* 마지막 pill이 잘리지 않도록 트랙에 더미 공간 추가 */
    #cat-track::after {
      content: '';
      flex: 0 0 2.5rem;
    }

    /* 카드 */
    .post-card {
      position: relative;
      border-radius: 16px;
      background: #fff;
      overflow: hidden;
      display: block;
      /* 레이어 개수/순서를 hover와 똑같이 맞춰야 box-shadow가 끊기지 않고 부드럽게 보간됨
         (링 spread가 0 → 4px로, 그림자가 옅게 → 진하게 자연스럽게 애니메이션) */
      box-shadow:
        0 0 0 0 rgba(116, 126, 137, 0),
        0 1px 3px rgba(17, 17, 17, 0.05);
      opacity: 0;
      transform: translateY(28px);
      transition: box-shadow 0.32s cubic-bezier(0.22, 1, 0.36, 1),
                  opacity 0.7s cubic-bezier(0.22, 1, 0.36, 1),
                  transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);
    }
    /* 스크롤로 뷰포트에 들어오면 setupScrollReveal()이 이 클래스를 붙임 */
    .post-card.is-visible {
      opacity: 1;
      transform: translateY(0);
    }
    /* border-width로 두꺼워지던 기존 효과는 콘텐츠 영역을 실제로 줄여 텍스트 줄바꿈을 유발했음 —
       box-shadow 링으로 대체해 레이아웃에 전혀 영향 없이 같은 느낌을 냄.
       transform(기울임/리프트)은 .tilt-card 전역 스크립트(Layout.astro)가 담당.
       hover:hover 미디어쿼리로 감싸서, 진짜 마우스/트랙패드가 있는 기기에서만 적용 —
       터치 기기는 스크롤 중 손가락이 스쳐도 :hover가 걸려서 스크롤할 때마다
       링이 켜지는 문제가 있었음. 터치 기기의 피드백은 is-touch-active(탭 시에만)가 담당 */
    @media (hover: hover) {
      .post-card:hover {
        box-shadow:
          0 0 0 4px #747e89,
          0 24px 40px -14px rgba(17, 17, 17, 0.32);
      }
    }
    /* 모바일 탭 피드백 — Layout.astro의 setupTouchCardFeedback()이 붙이는 클래스.
       테두리(stroke) 두께 애니메이션은 빼고, 살짝 눌리는 스케일만 남김 */
    .post-card.is-touch-active {
      transform: scale(0.97);
      transition: transform 0.15s ease;
    }

    .post-card-content { padding: 1.2rem; }
    .post-card-date { font-size: .8rem; color: #A0A0A0; margin-bottom: 0.3rem; }
    .post-card-title { font-size: 1.3rem; font-weight: 800; margin-bottom: 0rem; }
    .post-card-desc {
      font-size: 1rem !important;
      line-height: 1.4 !important;
      color: #5B5B5B;
      margin: 0 !important;
      display: -webkit-box;
      -webkit-box-orient: vertical;
      -webkit-line-clamp: 2;
      overflow: hidden;
    }

    body, html { background: #F8F8FF; }

    /* 스크롤바 숨김 */
    #cat-track { scrollbar-width: none; -ms-overflow-style: none; }
    #cat-track::-webkit-scrollbar { display: none; }
    #cat-track { scroll-behavior: smooth; }

    /* ▼ 카테고리 바 오른쪽 fade-out */
    #category-nav { position: relative; }
    #category-nav::after {
      content: '';
      position: absolute; right: 0; top: 0;
      width: 35px; height: 100%;
      pointer-events: none;
      background: linear-gradient(to right, rgba(248,248,255,0) 0%, #ebe9e5 100%);
    }

  /* 모바일에서는 네비게이션 우측 그라데이션 제거 */
  @media (max-width: 640px) {
    #category-nav::after {
      display: none;
    }
  }

  </style>
</Layout>
