---
import Layout from '../layouts/Layout.astro';

// .md 파일 수집
const postFiles = Object.entries(import.meta.glob('../content/posts/*.md', { eager: true }));

// frontmatter + slug 파싱
const allPosts = postFiles.map(([p, f]) => ({
  slug: p.split('/').pop().replace('.md', ''),
  ...f.frontmatter
}));

// 배포 환경에서는 draft:true 또는 미래 날짜(post.date > today) 숨김
const isProd = import.meta.env.PROD;
const today = new Date();
const posts = allPosts
  .filter(p => {
    if (!isProd) return true; // dev에서는 전부 보이도록
    const isDraft = p.draft === true;
    const isFuture = p.date ? new Date(p.date) > today : false;
    return !isDraft && !isFuture;
  })
  .sort((a, b) => new Date(b.date ?? 0) - new Date(a.date ?? 0));
---

<Layout title="Han Park | Projects">
  <div class="bg-[#ebe9e5] min-h-screen">

    <!-- 포스트 목록 -->
    <div id="posts-wrapper" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4 sm:gap-6 px-3 sm:px-6 pt-3 sm:pt-6 pb-6">
      <!-- 항상 맨 앞에 고정되는 프로필 카드 — 카테고리 필터와 무관하게 항상 보임 -->
      <a href="/profile" class="group post-card tilt-card">
        <div class="w-full aspect-square overflow-hidden profile-grid-thumb">
          <img src="/images/website/profile-thumb.webp" alt="Han Park"
               class="tilt-card-thumb w-full h-full object-cover"/>
        </div>
        <div class="post-card-content">
          <h3 class="post-card-title">Profile</h3>
          <p class="post-card-desc">Han Park — Graphic Designer</p>
        </div>
      </a>
      {posts.map(p => (
        <a href={`/posts/${p.slug}`} class="group post-card tilt-card"
           data-category={Array.isArray(p.category) ? p.category.join(',') : (p.category ?? '기타')}>
          <div class="w-full aspect-square overflow-hidden">
            <img src={p.image} alt={p.title}
                 class="tilt-card-thumb w-full h-full object-cover"/>
          </div>
          <div class="post-card-content">
            {p.date && <div class="post-card-date">{(new Date(p.date)).toLocaleDateString('ko-KR',{year:'numeric',month:'long',day:'numeric'})}</div>}
            <h3 class="post-card-title">{p.title}</h3>
            <p class="post-card-desc">{p.description}</p>
          </div>
        </a>
      ))}
    </div>
  </div>

  <!-- JS : 필터 (카테고리 선택은 nav의 햄버거 메뉴가 담당 — ?cat= 쿼리로 진입) -->
<script>
  const cards  = document.querySelectorAll('.post-card');

  // 공통 필터링 함수
  function filterPosts(cat) {
    localStorage.setItem('lastCategory', cat);

    // 카드 표시/숨김 처리 (프로필 카드처럼 data-category가 없는 카드는 필터와 무관하게 항상 표시)
    cards.forEach(c => {
      if (!c.dataset.category) return;
      const isMatch = cat === 'all' || c.dataset.category.split(',').includes(cat);
      c.style.display = isMatch ? 'block' : 'none';
    });
  }

  // 페이지 로드 시 상태 복원 — 햄버거 메뉴 등에서 ?cat= 로 들어온 경우 최우선 적용
  const catParam = new URLSearchParams(location.search).get('cat');
  const last = catParam || localStorage.getItem('lastCategory') || 'all';
  filterPosts(last);

  // 스크롤로 뷰포트에 들어오는 카드를 아래→위로 fade in — 나갔다 다시 들어올 때마다 매번 재생
  if ('IntersectionObserver' in window) {
    const io = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        entry.target.classList.toggle('is-visible', entry.isIntersecting);
      });
    }, { threshold: 0.15, rootMargin: '0px 0px -40px 0px' });
    cards.forEach((card) => io.observe(card));
  } else {
    // 미지원 브라우저는 그냥 바로 보이게
    cards.forEach((card) => card.classList.add('is-visible'));
  }
</script>

  <style>

    /* 카드 */
    /* 모바일(1열)에서는 정사각 썸네일이 첫 화면을 다 차지해서 아래 작품들이 안 보이던 문제 —
       세로로 납작하게 줄여서 다른 카드들도 바로 눈에 들어오게 함 */
    @media (max-width: 640px) {
      .post-card .profile-grid-thumb {
        aspect-ratio: auto;
        height: 84px;
      }
    }

    .post-card {
      position: relative;
      border-radius: 16px;
      background: #fff;
      overflow: hidden;
      display: block;
      /* 레이어 개수/순서를 hover와 똑같이 맞춰야 box-shadow가 끊기지 않고 부드럽게 보간됨
         (링 spread가 0 → 4px로, 그림자가 옅게 → 진하게 자연스럽게 애니메이션) */
      box-shadow:
        0 0 0 0 rgba(116, 126, 137, 0),
        0 1px 3px rgba(17, 17, 17, 0.05);
      opacity: 0;
      transform: translateY(28px);
      transition: box-shadow 0.32s cubic-bezier(0.22, 1, 0.36, 1),
                  opacity 0.7s cubic-bezier(0.22, 1, 0.36, 1),
                  transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);
    }
    /* 스크롤로 뷰포트에 들어오면 setupScrollReveal()이 이 클래스를 붙임 */
    .post-card.is-visible {
      opacity: 1;
      transform: translateY(0);
    }
    /* border-width로 두꺼워지던 기존 효과는 콘텐츠 영역을 실제로 줄여 텍스트 줄바꿈을 유발했음 —
       box-shadow 링으로 대체해 레이아웃에 전혀 영향 없이 같은 느낌을 냄.
       transform(기울임/리프트)은 .tilt-card 전역 스크립트(Layout.astro)가 담당.
       hover:hover 미디어쿼리로 감싸서, 진짜 마우스/트랙패드가 있는 기기에서만 적용 —
       터치 기기는 스크롤 중 손가락이 스쳐도 :hover가 걸려서 스크롤할 때마다
       링이 켜지는 문제가 있었음. 터치 기기의 피드백은 is-touch-active(탭 시에만)가 담당 */
    @media (hover: hover) {
      .post-card:hover {
        box-shadow:
          0 0 0 4px #747e89,
          0 24px 40px -14px rgba(17, 17, 17, 0.32);
      }
    }
    /* 모바일 탭 피드백 — Layout.astro의 setupTouchCardFeedback()이 붙이는 클래스.
       테두리(stroke) 두께 애니메이션은 빼고, 살짝 눌리는 스케일만 남김 */
    .post-card.is-touch-active {
      transform: scale(0.97);
      transition: transform 0.15s ease;
    }

    .post-card-content { padding: 1.2rem; }
    .post-card-date { font-size: .8rem; color: #A0A0A0; margin-bottom: 0.3rem; }
    .post-card-title { font-size: 1.3rem; font-weight: 800; margin-bottom: 0rem; }
    .post-card-desc {
      font-size: 1rem !important;
      line-height: 1.4 !important;
      color: #5B5B5B;
      margin: 0 !important;
      display: -webkit-box;
      -webkit-box-orient: vertical;
      -webkit-line-clamp: 2;
      overflow: hidden;
    }

    body, html { background: #F8F8FF; }

  </style>
</Layout>
