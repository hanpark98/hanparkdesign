      color: #8a8a8a;
    }
    .stat-eyebrow.no-border { border-bottom: none; padding-bottom: 0; margin-bottom: 16px; }

    /* 차트 카드 전용 헤딩 — 제목 → 그레이 헤어라인 → 부가설명 순서(다른 카드의
       title+subtitle가 함께 라인 위에 있는 stat-eyebrow와 다른, 차트 카드만의 변형) */
    .chart-eyebrow { margin-bottom: 20px; }
    .chart-eyebrow .title {
      display: block;
      font-size: 1.35rem;
      font-weight: 800;
      letter-spacing: -0.02em;
      text-transform: uppercase;
