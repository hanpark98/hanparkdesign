                                    {em.badgeSecondLine && <span class="fe-badge-second-line">{em.badgeSecondLine}</span>}
                                  </span>
                                </div>
                              )}
                            </figcaption>
                          )}
                        </figure>
                      ))}
                    </div>
                  </div>
                ))}
              </div>
            </div>
          )}

          {/* statSections[2] = Meta Creative Performance */}
          {frontmatter.statSections?.[2] && (
            <div class="bg-white p-6 sm:p-8 mb-4 card-shell fade-section">
              <div class="stat-eyebrow">
                <span class="title">{frontmatter.statSections[2].title}</span>
                {frontmatter.statSections[2].subtitle && <span class="subtitle">{frontmatter.statSections[2].subtitle}</span>}
              </div>
              <div class="stat-grid">
                {frontmatter.statSections[2].stats.map(s => (
                  <div class="stat-card">
                    <div class="stat-label">{s.label}</div>
                    <div class="stat-number">{s.prefix && <span class="plus">{s.prefix}</span>}{s.value}<span class="unit" class:list={{ 'unit-x': s.unit === 'x' }}>{s.unit}</span></div>
