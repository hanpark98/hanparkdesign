      padding: 14px 10px; border-bottom: 1px solid rgba(17, 17, 17, 0.07);
      font-size: 0.92rem; text-align: right; color: #111; vertical-align: middle;
      font-variant-numeric: tabular-nums;
    }
    .click-name {
      font-size: 0.95rem; font-weight: 600; color: #111;
    }
    .click-detail {
      font-size: 0.8rem; color: #8a8a8a; margin-top: 3px;
    }
    .click-ctr { font-weight: 700; font-size: 1rem; color: #5b74a3; }
    .click-mult { font-weight: 700; color: #111; }
    .click-table tr.is-avg td { background: #f7f6f4; color: #6b6b6b; font-weight: 600; }
    .click-table tr.is-avg .click-ctr { color: #6b6b6b; }

    /* ------------ How I Work — 에디토리얼 리스트 ------------
       [키커(포인트 컬러 대문자) + 제목 + 본문] 헤어라인 행 구성.
       성과 수치는 별도 컬럼 대신 본문 문장 속 형광펜 하이라이트(mark)로 녹여냄 */
    .tactics-list { display: flex; flex-direction: column; }
    .tactic-row {
      padding: 30px 0;
      border-bottom: 1px solid rgba(17, 17, 17, 0.07);
    }
    .tactic-row:first-child { padding-top: 8px; }
    .tactic-row:last-child { border-bottom: none; padding-bottom: 8px; }
    /* 키커와 제목을 같은 크기(1.05rem)로 — 키커는 포인트 컬러 대문자, 제목은 진한 볼드 */
    .tactic-kicker {
      font-size: 1.05rem;
      font-weight: 800;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      color: #5b74a3;
      margin-bottom: 6px;
    }
    /* 제목 앞에 포인트 링 도트(stat-label과 동일 양식) */
    .tactic-title {
      display: flex;
      align-items: center;
      gap: 7px;
      font-size: 1.05rem;
      font-weight: 800;
      color: #111;
      letter-spacing: -0.01em;
      line-height: 1.3;
      margin-bottom: 10px;
    }
    .tactic-title::before {
      content: '';
      width: 7px; height: 7px; border-radius: 50%;
      background: #e4e9f3;
      border: 1.5px solid #5b74a3;
      flex: none;
    }
    /* 본문 — scope 항목(CRM Design…)과 같은 크기(1.02rem). 전역 p 규칙(!important)이
       이기므로 여기도 !important로 고정 */
    .tactic-body {
      font-size: 1.02rem !important;
      line-height: 1.7 !important;
      color: #6b7684;
      max-width: 660px;
      margin: 0 !important;
    }
    /* 형광펜 하이라이트 — 글자 아래쪽 45%에만 포인트 컬러 워시가 깔리는 마커 톤 */
    .tactic-body mark {
      background: linear-gradient(transparent 55%, rgba(91, 116, 163, 0.22) 55%);
      color: inherit;
      font-weight: inherit;
      padding: 0 1px;
    }
    .tactic-body strong { font-weight: 650; color: #1a2430; }
    @media (max-width: 640px) {
      .tactic-row { padding: 24px 0; }
    }

    /* ------------ How I Work ver2 — Featured Emails (애플 bento 스타일) ------------
       헤어라인 행 대신 옅은 그레이 라운드 타일을 세로로 쌓고, 타일마다
       [내러티브 텍스트 | 아이폰 목업 + 히어로 지표]를 좌우 교차 배치.
       기기당 큰 숫자 하나(heroLabel/hero)가 주인공 — 애플 제품 페이지 문법 */
    .fe-groups { display: flex; flex-direction: column; gap: 18px; margin-top: 4px; }
    .fe-group {
      display: grid;
      grid-template-columns: minmax(0, 300px) 1fr;
      gap: 44px;
      align-items: center;
      background: #f5f6f8;
      border-radius: 24px;
      padding: 36px 38px;
    }
    /* 모든 좌우형 타일은 텍스트 왼쪽, 목업 오른쪽으로 통일 */
    /* 텍스트 컬럼 — How I Work의 kicker/title/body 위계 그대로 재사용 */
    .fe-tag {
      font-size: 0.82rem; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase;
      color: #5b74a3; margin-bottom: 8px;
    }
    .fe-kicker {
      font-size: 1.45rem; font-weight: 800; color: #111; letter-spacing: -0.02em; line-height: 1.25;
      margin-bottom: 12px;
    }
    /* 목업 컬럼 — pair는 폰 2개 나란히, solo는 1개. 폰은 칸에 맞춰 줄어듦.
       레일(오른쪽 바깥 −20px)이 이웃 폰과 답답하지 않게 폰 사이 간격을 넉넉히 */
    .fe-phones { display: flex; gap: 42px; align-items: flex-start; justify-content: center; }
    .fe-phone-fig { margin: 0; flex: 1 1 0; min-width: 0; max-width: 216px; }

    /* ver3의 Calendar·Timing은 텍스트 위, 목업 갤러리 아래의 전체 폭 구성 */
    .fe-group.is-gallery,
    .fe-group.is-sequence {
      grid-template-columns: 1fr;
      gap: 30px;
    }
    .fe-group.is-gallery .fe-group-text,
    .fe-group.is-sequence .fe-group-text,
    .fe-group.is-gallery .fe-phones,
    .fe-group.is-sequence .fe-phones {
      order: 0;
    }
    .fe-group.is-gallery .fe-group-text,
    .fe-group.is-sequence .fe-group-text { max-width: 720px; }
    .fe-group.is-gallery .fe-phones,
    .fe-group.is-sequence .fe-phones {
      display: grid;
      width: 100%;
      gap: 34px;
      align-items: start;
    }
    .fe-group.is-gallery .fe-phones { grid-template-columns: repeat(4, minmax(0, 1fr)); }
    .fe-group.is-sequence .fe-phones { grid-template-columns: repeat(4, minmax(0, 1fr)); }
    .fe-group.is-gallery .fe-phone-fig,
    .fe-group.is-sequence .fe-phone-fig {
      width: 100%;
      max-width: 190px;
      justify-self: center;
    }
    /* Revenue 중심 시퀀스: 원본 성과 데이터는 유지하되 카드에서는 보조 지표를 감춤 */
    .fe-group.is-revenue-only .fe-cap-seg,
    .fe-group.is-revenue-only .fe-cap-sub { display: none; }

    /* 아이폰 목업 — 실제 애플 프레임 비율: 화면 9:19.5, 사방 균일한 슬림 베젤,
       큰 코너 라운드. 장식(노치/슬릿) 없이 클린 프레임, 부드러운 플로팅 섀도.
       코너/베젤은 컨테이너 폭 비례(cqw) — 창 크기로 폰이 줄어도 커브 비율이 안 무너짐
       (px 값은 cqw 미지원 브라우저용 폴백) */
    .fe-phone-fig { container-type: inline-size; }
    .fe-phone {
      position: relative;
      background: #16181c;
      border-radius: 42px;
      border-radius: 19.4cqw;
      padding: 8px;
      padding: 3.7cqw;
      box-shadow: 0 18px 40px rgba(26, 36, 48, 0.18), inset 0 0 0 1px rgba(255,255,255,0.06);
    }
    .fe-phone-screen {
      position: relative;
      aspect-ratio: 9 / 19.5;
      overflow-y: auto;
      overflow-x: hidden;
      border-radius: 34px;
      border-radius: 15.7cqw;
      background: #fff;
      /* 목업 경계의 흰 탄성 영역은 숨기고, 페이지 전달은 아래 JS에서 명시적으로 처리 */
      overscroll-behavior-x: none;
      overscroll-behavior-y: none;
      -webkit-overflow-scrolling: auto;
      scrollbar-width: none;
    }
    .fe-phone-screen::-webkit-scrollbar { display: none; }
    /* 모바일에서는 화면 스와이프를 페이지 스크롤에 양보하고,
       내부 콘텐츠는 오른쪽 손잡이로만 조작한다. overflow:hidden이어도 JS scrollTop 제어는 유지된다. */
    @media (hover: none) and (pointer: coarse) {
      .fe-phone-screen {
        overflow-y: hidden;
        touch-action: pan-y;
        pointer-events: none;
      }
    }
    /* 여러 이미지·GIF가 업로드 순서대로 틈 없이 세로 스택됨 */
    .fe-phone-screen img {
      display: block;
      width: 100%;
      height: auto;
      margin: 0 !important;
      border-radius: 0 !important;
    }
    .fe-phone-screen img + img { margin-top: -1px !important; }

    /* 스크롤 인디케이터 — 화면 밖 오른쪽: 얇은 회색 세로선 위를 상하로 긴 알약 손잡이
       (위아래 화살표 포함, 모든 폰 동일한 고정 크기)가 이동. 드래그·레일 클릭으로 제어,
       위치는 JS가 px로 계산 */
    /* 세로선은 시각 가이드일 뿐 — 클릭·커서 반응 없음(조작은 알약 손잡이로만) */
    .fe-rail {
      position: absolute; top: 10px; bottom: 10px; right: -20px; width: 2px;
      background: rgba(17, 17, 17, 0.1); border-radius: 1px;
    }
    .fe-rail-knob {
      position: absolute; left: 50%; top: 0;
      width: 16px; height: 36px; border-radius: 8px;
      background: #5b74a3;
      transform: translateX(-50%);
      box-shadow: 0 0 0 2px #f5f6f8, 0 2px 6px rgba(26, 36, 48, 0.25);
      display: flex; align-items: center; justify-content: center;
      color: #fff;
      cursor: grab;
      touch-action: none;
      z-index: 3;
      -webkit-tap-highlight-color: transparent;
      user-select: none;
    }
    /* 시각 크기는 그대로 두고 터치 판정 영역만 모바일 권장 크기 이상으로 확장 */
    .fe-rail-knob::before {
      content: '';
      position: absolute;
      inset: -8px -14px;
      border-radius: 22px;
    }
    .fe-rail-knob:active { cursor: grabbing; }
    .fe-rail-knob svg { width: 10px; height: 18px; }
    .fe-phone.no-scroll .fe-rail { display: none; }

    /* 캡션 상단 — 이메일 제목·세그먼트(목업 위). pair에서 제목 줄수가 달라도 폰 상단이
       정렬되도록 2줄 분량을 예약하고 아래 정렬 */
    .fe-cap-top {
      display: flex; flex-direction: column; justify-content: flex-end;
      min-height: 3.6rem;
      margin-bottom: 14px;
      text-align: center;
    }
    .fe-cap-label { font-size: 0.92rem; font-weight: 600; color: #111; letter-spacing: -0.01em; line-height: 1.3; }
    .fe-cap-date { font-size: 0.78rem; font-weight: 500; color: #8a8a8a; margin-top: 2px; }
    .fe-cap-seg { font-size: 0.78rem; font-weight: 500; color: #8a8a8a; margin-top: 2px; }
    /* Calendar 날짜는 데이터에 유지하되 화면에서는 캠페인명만 노출 */
    .fe-group.is-gallery .fe-cap-seg { display: none; }
    /* 캡션 하단 — 애플식 스탯: 작은 대문자 라벨 → 큰 히어로 숫자 → 기타지표 한 줄 */
    .fe-cap-bottom { margin-top: 16px; text-align: center; }
    .fe-hero-label {
      font-size: 0.68rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase;
      color: #8a8a8a; margin-bottom: 2px;
    }
    .fe-hero {
      font-size: 1.9rem; font-weight: 800; letter-spacing: -0.02em; line-height: 1.15;
      color: #111; font-variant-numeric: tabular-nums;
    }
    .fe-hero.is-muted { color: #b0b6bd; }
    .fe-badge {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      margin-top: 8px;
      padding: 5px 9px;
      border: 1px solid #ead46c;
      border-radius: 999px;
      background: #fff4bd;
      color: #6f5900;
      font-size: 0.68rem;
      font-weight: 750;
      line-height: 1.2;
      letter-spacing: -0.01em;
      box-shadow: 0 3px 8px rgba(111, 89, 0, 0.12);
    }
    .fe-badge::before { content: "★"; font-size: 0.65rem; }
    .fe-badge-second-line::before { content: " "; }
    .fe-cap-sub { font-size: 0.8rem; font-weight: 500; color: #8a8a8a; margin-top: 4px; font-variant-numeric: tabular-nums; }
    /* 그룹 본문(기존 How I Work 내러티브) — tactic-body 위계 그대로 재사용 */
    .fe-body {
      font-size: 1.02rem !important; line-height: 1.7 !important; color: #6b7684;
      margin: 0 !important;
    }
    .fe-body mark {
      background: linear-gradient(transparent 55%, rgba(91, 116, 163, 0.22) 55%);
      color: inherit; font-weight: inherit; padding: 0 1px;
    }
    .fe-body strong { font-weight: 650; color: #1a2430; }

    /* 태블릿~좁은 데스크톱: 타일 내부를 세로 스택(텍스트 위 → 목업 아래)으로 전환 */
    @media (max-width: 900px) {
      .fe-group { grid-template-columns: 1fr; gap: 26px; padding: 28px 24px; }
      .fe-group.is-gallery .fe-phones { grid-template-columns: repeat(2, minmax(0, 1fr)); }
      .fe-group.is-sequence .fe-phones { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    }
    @media (max-width: 640px) {
      /* 모바일은 목업을 2열로 압축해 비교성을 높이고 전체 페이지 길이를 줄임 */
      .fe-group { padding: 26px 20px; border-radius: 20px; }
      .fe-phones,
      .fe-group.is-gallery .fe-phones,
      .fe-group.is-sequence .fe-phones {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 30px 24px;
        width: 100%;
        align-items: start;
      }
      .fe-phone-fig,
      .fe-group.is-gallery .fe-phone-fig,
      .fe-group.is-sequence .fe-phone-fig {
        max-width: 150px;
        width: 100%;
        justify-self: center;
      }
      /* Timing처럼 홀수 개면 마지막 목업을 마지막 줄 중앙에 */
      .fe-phones > .fe-phone-fig:last-child:nth-child(odd) {
        grid-column: 1 / -1;
      }
      .fe-rail { right: -14px; }
      .fe-kicker { font-size: 1.25rem; }
      .fe-cap-top { min-height: 0; }
      .fe-cap-label { font-size: 0.8rem; }
      .fe-cap-date { font-size: 0.7rem; }
      .fe-cap-seg { font-size: 0.7rem; }
      .fe-hero { font-size: 1.55rem; }
      .fe-cap-sub { font-size: 0.72rem; }
      .fe-badge-second-line { display: block; }
      .fe-badge-second-line::before { content: none; }
    }
    @media (max-width: 350px) {
      .fe-phones,
      .fe-group.is-gallery .fe-phones,
      .fe-group.is-sequence .fe-phones {
        grid-template-columns: 1fr;
      }
      .fe-phone-fig,
      .fe-group.is-gallery .fe-phone-fig,
      .fe-group.is-sequence .fe-phone-fig { max-width: 190px; }
      .fe-phones > .fe-phone-fig:last-child:nth-child(odd) { grid-column: auto; }
      .fe-rail { right: -20px; }
    }

    /* PC: 항목이 늘어나도 자연스럽게 3열 이상으로 확장되도록 auto-fit —
       고정 2열이 아니라 카드 너비(160px) 기준으로 들어가는 만큼 열이 생김 */
    .stat-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
      column-gap: 28px;
      row-gap: 30px;
    }
    /* 차트 바로 아래에 오는 스탯 그리드는 차트와 분리되는 여백을 좀 더 확보 */
    .stat-grid-chart { margin-top: 32px; }
    .stat-card { padding: 0; }
    /* 항목 제목 — profile.astro .skills-category와 위계/표기법 통일:
       Title Case 그대로(uppercase 변환 없음), 진한 색(#111), -0.01em, 700, 1.08rem */
    /* min-height는 라벨 2줄 분량(line-height 1.35 × 2) — 같은 행의 라벨이 1줄/2줄로
       길이가 갈려도 아래 stat-number가 카드마다 다른 높이에서 시작하지 않도록 자리 확보 */
    .stat-label {
      display: flex;
      align-items: flex-start;
      gap: 7px;
      font-size: 1.08rem;
      font-weight: 700;
      letter-spacing: -0.01em;
      color: #111;
      line-height: 1.35;
      min-height: 2.95rem;
      margin-bottom: 12px;
    }
    .stat-label::before {
      content: '';
      width: 7px; height: 7px; border-radius: 50%;
      background: #e4e9f3;
      border: 1.5px solid #5b74a3;
      flex: none;
      margin-top: 0.45rem;
    }
    .stat-number {
      font-size: 2.75rem;
      font-weight: 800;
      letter-spacing: -0.02em;
      line-height: 1;
      color: #111;
      font-variant-numeric: tabular-nums;
      white-space: nowrap;
    }
    /* 단위 기호 — 베이스라인에 그대로 두면 큰 숫자 옆에서 아래로 치우쳐 보이므로
       살짝 끌어올려 숫자의 광학적 중심에 가깝게 정렬 */
    .stat-number .unit {
      font-size: 1.4rem;
      font-weight: 700;
      color: #5b74a3;
      margin-left: 2px;
      vertical-align: 0.32em;
    }
    /* 소문자 x는 x-height 글리프라 같은 700에서도 %보다 얇고 낮게 보임 — 실제 상승량을
       %(0.32em×1.4rem≈0.45rem)와 맞추고(0.28em×1.6rem≈0.45rem), 얇아 보이는 건
       800 굵기로 보정해 %와 두께·높이를 통일 */
    .stat-number .unit-x { font-size: 1.6rem; font-weight: 800; vertical-align: 0.28em; }
    .stat-number .plus {
      color: #5b74a3;
    }
    .stat-detail {
      font-size: 0.95rem;
      line-height: 1.5;
      color: #8a8a8a;
      margin-top: 10px;
      max-width: 24ch;
    }
    @media (max-width: 640px) {
      /* 모바일 2열 — 라벨이 1줄/2줄로 갈려도 min-height(2줄 분량)가 자리를 잡아
         같은 행의 수치 시작 높이가 항상 정렬됨. detail 줄바꿈은 행 아래쪽에서만 발생 */
      .stat-grid { grid-template-columns: repeat(2, 1fr); column-gap: 18px; row-gap: 30px; }
      .stat-label { font-size: 1rem; min-height: 2.7rem; margin-bottom: 10px; }
      .stat-label::before { margin-top: 0.4rem; }
      .stat-number { font-size: 2.35rem; }
      .stat-number .unit { font-size: 1.2rem; }
      .stat-number .unit-x { font-size: 1.35rem; }
      .stat-detail { font-size: 0.88rem; margin-top: 8px; max-width: none; }
    }

    .team-result-period,
    .section-source {
      font-size: 0.95rem;
      line-height: 1.05;
      color: #a8a8a8;
    }
    .team-result-period {
      margin-top: 28px;
      padding-top: 16px;
      border-top: 1px solid #ececec;
      white-space: pre-line;
    }
    .section-source {
      margin-top: 10px;
    }
    .stat-grid + .section-source {
      margin-top: 28px;
      padding-top: 16px;
      border-top: 1px solid #ececec;
    }
    @media (max-width: 640px) {
      .team-result-period,
      .section-source { font-size: 0.88rem; }
    }

    /* ------------ 케이스 스터디 각주 — 카드 없이 옅은 글씨로만 ------------ */
    .case-footnote {
      max-width: 760px;
      margin: 0 auto;
      padding: 12px 16px 32px;
      font-size: 0.78rem;
      line-height: 1.8;
      color: #a8a8a8;
      font-variant-numeric: tabular-nums;
    }
    .case-footnote-title {
      margin-bottom: 10px;
      text-align: center;
      font-size: 0.72rem;
      font-weight: 700;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: #969696;
    }
    .case-footnote-body { text-align: left; }
    .case-footnote p + p { margin-top: 4px; }

    /* ------------ 매출 추이 차트 (애플 Stocks/Health류 미니멀 곡선 스타일) ------------
       사이트 폰트(Apple SD Gothic Neo 계열)만 사용 — 텍스트는 body에서 상속, 숫자 정렬은
       tabular-nums로. 2구간 — decline(하락, 절제된 로즈 #b16c7a — 사이트에서 유일하게
       쓰는 "경고" 색) → recover(회복, 포인트 컬러 #5b74a3 — posts.astro 카드 링/스탯
       포인트와 항상 통일). 축/그리드/평균선 없이 곡선과 최소 라벨만 남겨 여백 위주로 구성 */
    /* 데이터 출처 캡션 — stat-label과 동일한 디자인(1.08rem/700/#111 + 포인트 링 도트),
       그래프 왼쪽 상단에 배치 */
    .trend-unit-label {
      display: flex;
      align-items: center;
      gap: 7px;
      font-size: 1.08rem;
      font-weight: 700;
      letter-spacing: -0.01em;
      color: #111;
      line-height: 1.35;
      margin: 0 0 10px;
    }
    .trend-unit-label::before {
      content: '';
      width: 7px; height: 7px; border-radius: 50%;
      background: #e4e9f3;
      border: 1.5px solid #5b74a3;
      flex: none;
    }
    @media (max-width: 640px) {
      .trend-unit-label { font-size: 1rem; }
    }
    /* 플롯 래퍼 — SVG(선·면·도트)와 HTML 텍스트 오버레이를 겹쳐 얹는 기준 컨테이너.
       SVG는 width:100%/height:auto라 viewBox 비율대로 박스가 잡히고, 오버레이는 그
       박스에 대한 % 좌표로 데이터 포인트에 정렬됨 */
    .trend-plot {
      position: relative;
      margin-top: 4px;
    }
    .trend-svg {
      display: block;
      width: 100%;
      height: auto;
    }
    /* 라인 전체 아래 통합 면 — 좌우 컬러 그라디언트 + 상하 페이드 마스크는 마크업 style로 지정 */
    .trend-area { stroke: none; }
    /* 연속 곡선 — 얇은 실선. (stroke-dasharray 그리기 애니메이션이 pathLength=100 정규화에
       의존하므로 non-scaling-stroke는 쓰지 않음 — 둘을 겹치면 대시가 화면 px로 재해석돼
       선이 점선처럼 끊김) */
    .trend-line {
      fill: none; stroke-width: 1.8;
      stroke-linejoin: round; stroke-linecap: round;
    }
    .trend-hit { fill: transparent; }
    /* 시작·저점·끝 흰 도트 — 선 색 링(non-scaling-stroke) */
    .trend-dot { fill: #ffffff; stroke: #5F6E7A; stroke-width: 1.6; }
    .trend-dot.dot-end,
    .trend-dot.dot-takeover { stroke: #5b74a3; }

    /* ── HTML 텍스트 오버레이 — SVG 밖이라 컨테이너 스케일과 무관하게 항상 고정 rem ── */
    .trend-ovl {
      position: absolute;
      font-family: 'Apple SD Gothic Neo', 'Malgun Gothic', sans-serif;
      pointer-events: none;
      white-space: nowrap;
    }
    /* 월 라벨 — 플롯 하단 라인 바로 아래. 양 끝은 start/end 정렬로 가장자리 클리핑 방지 */
    .trend-ovl-month {
      transform: translate(-50%, 8px);
      font-size: 0.82rem;
      letter-spacing: 0.02em;
      color: #A0A8AF;
    }
    .trend-ovl-month.ovl-start { transform: translate(0, 8px); }
    .trend-ovl-month.ovl-end { transform: translate(-100%, 8px); }
    /* 값 라벨 — 각 도트 바로 위. 금액은 읽혀야 하므로 살짝 크게·진하게 */
    .trend-ovl-value {
      transform: translate(-50%, calc(-100% - 8px));
      font-size: 0.9rem;
      font-weight: 700;
      color: #5a6472;
      font-variant-numeric: tabular-nums;
    }
    /* 양 끝 값 라벨은 살짝 더 띄워 곡선(최고점)과 여유를 둠 */
    .trend-ovl-value.ovl-start { transform: translate(0, calc(-100% - 13px)); }
    .trend-ovl-value.ovl-end { transform: translate(-100%, calc(-100% - 13px)); }
    /* 합류 시점 말풍선 — 저점 값 라벨 위에 포인트 컬러 필 + 아래를 가리키는 꼬리 */
    .trend-ovl-bubble {
      transform: translate(-50%, calc(-100% - 46px));
      background: #5b74a3;
      color: #fff;
      font-size: 0.76rem;
      font-weight: 700;
      letter-spacing: 0.03em;
      padding: 3px 11px;
      border-radius: 11px;
    }
    .trend-ovl-bubble::after {
      content: '';
      position: absolute;
      left: 50%; top: 100%;
      transform: translateX(-50%);
      border: 5px solid transparent;
      border-bottom: 0;
      border-top-color: #5b74a3;
    }
    @media (max-width: 640px) {
      /* 모바일에서 월 라벨이 상대적으로 커 보여 축소 */
      .trend-ovl-month { font-size: 0.7rem; transform: translate(-50%, 6px); }
      .trend-ovl-month.ovl-start { transform: translate(0, 6px); }
      .trend-ovl-month.ovl-end { transform: translate(-100%, 6px); }
      .trend-ovl-value { font-size: 0.8rem; }
      .trend-ovl-bubble { transform: translate(-50%, calc(-100% - 56px)); }
    }
    /* 라인 드로잉 애니메이션 — 페이지 진입 시 왼쪽에서 오른쪽으로 한 번 그려짐.
       곡선(Bezier) 실제 길이를 예측하기 어려우므로 pathLength="100" 정규화 값 기준 */
    @media (prefers-reduced-motion: no-preference) {
      .trend-line {
        stroke-dasharray: 100;
        stroke-dashoffset: 100;
        animation: trend-draw 1.6s 0.3s cubic-bezier(0.22, 1, 0.36, 1) forwards;
      }
    }
    @keyframes trend-draw { to { stroke-dashoffset: 0; } }
  </style>

<script>
    function setupMarquee(speed = 0.8) {
      const marquees = document.querySelectorAll('.marquee-mode');
      marquees.forEach(marquee => {
        const track = marquee.querySelector('.marquee-track');
        if (!track) return;

        track.style.setProperty('scroll-behavior', 'auto', 'important');

        const originalItems = Array.from(track.children);
        if (originalItems.length === 0) return;

        // 원본 3세트를 뒤에 복제하여 충분히 여유로운 트랙 생성 (총 4세트)
        originalItems.forEach(item => track.appendChild(item.cloneNode(true)));
        originalItems.forEach(item => track.appendChild(item.cloneNode(true)));
        originalItems.forEach(item => track.appendChild(item.cloneNode(true)));

        const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const canHover = window.matchMedia('(hover: hover)').matches;
        let isPointerHovering = false;
        let isPaused = prefersReducedMotion;
        let touchResumeTimer = 0;
        let resetPoint = 0;
        
        let currentScroll = 0; 
        let targetScroll = 0;  

        function calculateWidth() {
          resetPoint = originalItems.reduce((acc, item) => acc + item.offsetWidth, 0);
          
          if (currentScroll === 0 && resetPoint > 0) {
            currentScroll = resetPoint;
            targetScroll = resetPoint;
            track.scrollLeft = resetPoint;
          }
        }

        // 1. 애니메이션 루프
        function step() {
          if (resetPoint > 0) {
            if (!isPaused) {
              targetScroll += speed;
            }

            currentScroll += (targetScroll - currentScroll) * 0.08;

            // 루프 경계 처리 시, delta 계산에 영향을 주지 않도록 내부에서만 값을 보정
            if (currentScroll >= resetPoint * 2) {
              currentScroll -= resetPoint;
              targetScroll -= resetPoint;
            } else if (currentScroll < resetPoint) {
              currentScroll += resetPoint;
              targetScroll += resetPoint;
            }

            track.scrollLeft = currentScroll;
          }
          requestAnimationFrame(step);
        }

        // 2. 세로 휠은 페이지 스크롤로 통과시키고,
        // 트랙패드 등의 명확한 가로 입력만 마키 조작에 사용한다.
        track.addEventListener('wheel', (e) => {
          if (Math.abs(e.deltaX) > Math.abs(e.deltaY)) {
            e.preventDefault();
            targetScroll += e.deltaX * 1.2;
          }
        }, { passive: false });

        // 3. 모바일 터치 및 PC 마우스 드래그 조작
        let isDragging = false;
        let didDrag = false;
        let lastX = 0;
        let startX = 0;
        let touchStartX = 0;
        let touchStartY = 0;
        let touchAxis = '';
        const touchThreshold = 10;

        const onDragStart = (clientX, gestureStartX = clientX) => {
          isDragging = true;
          startX = gestureStartX;
          lastX = clientX;
          track.classList.add('is-dragging');
        };

        const onDragMove = (clientX) => {
          if (!isDragging) return;
          const diff = lastX - clientX;
          targetScroll += diff * 1.5;
          if (Math.abs(startX - clientX) > 5) didDrag = true;
          lastX = clientX;
        };

        const onDragEnd = () => {
          isDragging = false;
          track.classList.remove('is-dragging');
        };

        const scheduleTouchResume = () => {
          if (prefersReducedMotion || isPointerHovering || !isPaused) return;
          touchResumeTimer = window.setTimeout(() => {
            touchResumeTimer = 0;
            if (!isPointerHovering) isPaused = false;
          }, 900);
        };

        const onTouchEnd = () => {
          if (touchAxis === 'horizontal') onDragEnd();
          touchAxis = '';
          scheduleTouchResume();
        };

        track.addEventListener('touchstart', (e) => {
          if (touchResumeTimer) {
            window.clearTimeout(touchResumeTimer);
            touchResumeTimer = 0;
          }
          const touch = e.touches[0];
          touchStartX = touch.clientX;
          touchStartY = touch.clientY;
          touchAxis = '';
          didDrag = false;
        }, { passive: true });

        track.addEventListener('touchmove', (e) => {
          const touch = e.touches[0];
          const deltaX = touch.clientX - touchStartX;
          const deltaY = touch.clientY - touchStartY;

          if (!touchAxis) {
            if (Math.max(Math.abs(deltaX), Math.abs(deltaY)) < touchThreshold) return;
            touchAxis = Math.abs(deltaX) > Math.abs(deltaY) ? 'horizontal' : 'vertical';

            if (touchAxis === 'horizontal') {
              isPaused = true;
              onDragStart(touch.clientX, touchStartX);
            }
          }

          if (touchAxis === 'horizontal') {
            e.preventDefault();
            onDragMove(touch.clientX);
          }
        }, { passive: false });

        track.addEventListener('touchend', onTouchEnd);
        track.addEventListener('touchcancel', onTouchEnd);

        track.addEventListener('mousedown', (e) => {
          didDrag = false;
          onDragStart(e.clientX);
        });
        track.addEventListener('mousemove', (e) => {
          if (isDragging) {
            e.preventDefault();
            onDragMove(e.clientX);
          }
        });
        track.addEventListener('mouseup', onDragEnd);

        track.addEventListener('click', (e) => {
          if (isDragging || didDrag) {
            e.preventDefault();
            e.stopPropagation();
          }
          didDrag = false;
        }, { capture: true });

        track.addEventListener('mouseenter', () => {
          if (!canHover) return;
          isPointerHovering = true;
          isPaused = true;
        });
        track.addEventListener('mouseleave', () => {
          if (!canHover) return;
          isPointerHovering = false;
          if (!prefersReducedMotion && !touchResumeTimer) isPaused = false;
          onDragEnd();
        });

        window.addEventListener('resize', calculateWidth);
        
        setTimeout(() => {
          calculateWidth();
          step();
        }, 100);
      });
    }

    document.addEventListener("DOMContentLoaded", function () {
      // 스크롤로 뷰포트에 들어오는 본문 섹션(card-shell)을 fade in하고,
      // 벗어났다가 다시 들어오면 재생한다. getBoundingClientRect/IntersectionObserver는
      // translateY의 영향을 받아 경계에서 판정이 반복될 수 있으므로, transform과 무관한
      // offsetTop/offsetHeight를 기준으로 실제 레이아웃의 교차 영역을 계산한다.
      const fadeSections = document.querySelectorAll<HTMLElement>('.fade-section');
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        fadeSections.forEach((section) => section.classList.add('is-visible'));
      } else {
        const getLayoutTop = (element: HTMLElement) => {
          let top = 0;
          let node: HTMLElement | null = element;
          while (node) {
            top += node.offsetTop;
            node = node.offsetParent as HTMLElement | null;
          }
          return top;
        };

        let fadeTicking = false;
        const updateFadeSections = () => {
          const viewportTop = Math.max(
            window.scrollY,
            document.documentElement.scrollTop,
            document.body.scrollTop
          );
          const viewportBottom = viewportTop + window.innerHeight - 40;

          fadeSections.forEach((section) => {
            const height = section.offsetHeight;
            const sectionTop = getLayoutTop(section);
            const sectionBottom = sectionTop + height;
            const visiblePixels = Math.max(
              0,
              Math.min(sectionBottom, viewportBottom) - Math.max(sectionTop, viewportTop)
            );
            const neededPixels = Math.min(height * 0.15, window.innerHeight * 0.2);
            const isVisible = section.classList.contains('is-visible');

            if (!isVisible && visiblePixels >= neededPixels) {
              section.classList.add('is-visible');
            } else if (isVisible && visiblePixels <= 0) {
              section.classList.remove('is-visible');
            }
          });

          fadeTicking = false;
        };

        const requestFadeUpdate = () => {
          if (fadeTicking) return;
          fadeTicking = true;
          requestAnimationFrame(updateFadeSections);
        };

        // 모바일에서는 body/document가 실제 스크롤 컨테이너가 될 수 있고 scroll 이벤트는
        // 버블링되지 않으므로 document의 캡처 단계에서 모든 문서 스크롤을 받는다.
        document.addEventListener('scroll', requestFadeUpdate, { passive: true, capture: true });
        window.addEventListener('resize', requestFadeUpdate);
        window.addEventListener('load', requestFadeUpdate);
        requestFadeUpdate();
      }

      // 처음 두 섹션은 스크롤과 상관없이 페이지 진입 시 바로 fade in
      const loadFadeEls = document.querySelectorAll('.load-fade');
      requestAnimationFrame(() => requestAnimationFrame(() => {
        loadFadeEls.forEach((el) => el.classList.add('is-loaded'));
      }));

      // Featured Emails — 아이폰 목업 세로 스크롤. 회색 세로 레일 위의 고정 크기
      // 원형 손잡이(knob)가 스크롤 진행도만큼 위→아래로 이동. 이미지 로드 후 재계산
      document.querySelectorAll('.fe-phone').forEach(function(phone) {
        const screen = phone.querySelector('.fe-phone-screen');
        const rail = phone.querySelector('.fe-rail');
        const knob = phone.querySelector('.fe-rail-knob');
        if (!screen || !rail || !knob) return;
        const update = () => {
          const maxScroll = screen.scrollHeight - screen.clientHeight;
          phone.classList.toggle('no-scroll', maxScroll < 6);
          if (maxScroll < 6) return;
          const travel = Math.max(0, rail.clientHeight - knob.offsetHeight);
          const clampedScroll = Math.max(0, Math.min(screen.scrollTop, maxScroll));
          knob.style.top = (clampedScroll / maxScroll * travel) + 'px';
        };
        screen.addEventListener('scroll', update, { passive: true });
        window.addEventListener('resize', update);
        // 여러 이미지/GIF가 순차 로드되며 scrollHeight가 계속 늘어날 수 있으므로
        // 첫 장뿐 아니라 모든 미디어의 로드·크기 변화를 감지한다.
        const images = screen.querySelectorAll('img');
        images.forEach((img) => {
          if (!img.complete) {
            img.addEventListener('load', update, { once: true });
            img.addEventListener('error', update, { once: true });
          }
        });
        if ('ResizeObserver' in window) {
          const mediaResizeObserver = new ResizeObserver(update);
          images.forEach(img => mediaResizeObserver.observe(img));
        }
        window.addEventListener('load', update, { once: true });
        requestAnimationFrame(update);

        // 브라우저가 한 번의 휠 제스처를 내부 화면에 계속 묶어두는 스크롤 래칭을 보완한다.
        // 진행 방향으로 내부 콘텐츠가 남아 있으면 기본 스크롤을 유지하고,
        // 맨 위·아래 경계에서 바깥쪽으로 계속 스크롤할 때만 페이지로 즉시 넘긴다.
        const isLeavingScreen = (deltaY) => {
          const maxScroll = screen.scrollHeight - screen.clientHeight;
          if (maxScroll < 6 || deltaY === 0) return false;

          const atTop = screen.scrollTop <= 1;
          const atBottom = screen.scrollTop >= maxScroll - 1;
          return (deltaY < 0 && atTop) || (deltaY > 0 && atBottom);
        };

        const scrollPageBy = (deltaY) => {
          const pageScroller = document.scrollingElement;
          if (pageScroller) {
            pageScroller.scrollTop += deltaY;
          } else {
            window.scrollBy({ top: deltaY, behavior: 'auto' });
          }
        };

        screen.addEventListener('wheel', (e) => {
          if (!isLeavingScreen(e.deltaY)) return;
          e.preventDefault();
          const pageDelta = e.deltaMode === WheelEvent.DOM_DELTA_LINE
            ? e.deltaY * 16
            : e.deltaMode === WheelEvent.DOM_DELTA_PAGE
              ? e.deltaY * window.innerHeight
              : e.deltaY;
          scrollPageBy(pageDelta);
        }, { passive: false });

        // 손잡이 드래그 — 포인터 캡처로 알약을 잡고 끌면 화면이 비례해 스크롤
        let dragging = false, dragStartY = 0, dragStartTop = 0;
        knob.addEventListener('pointerdown', (e) => {
          const maxScroll = screen.scrollHeight - screen.clientHeight;
          if (maxScroll < 6) return;
          dragging = true;
          dragStartY = e.clientY;
          dragStartTop = screen.scrollTop;
          knob.setPointerCapture(e.pointerId);
          e.preventDefault();
        });
        knob.addEventListener('pointermove', (e) => {
          if (!dragging) return;
          const maxScroll = screen.scrollHeight - screen.clientHeight;
          const travel = Math.max(0, rail.clientHeight - knob.offsetHeight);
          if (travel <= 0) return;
          const nextScroll = dragStartTop + (e.clientY - dragStartY) / travel * maxScroll;
          screen.scrollTop = Math.max(0, Math.min(nextScroll, maxScroll));
        });
        const endDrag = () => { dragging = false; };
        knob.addEventListener('pointerup', endDrag);
        knob.addEventListener('pointercancel', endDrag);
      });

      document.querySelectorAll('.my-carousel').forEach(function(carousel) {
        if (carousel.classList.contains('marquee-mode')) return;
        const scrollArea = carousel.querySelector('.my-carousel-scroll');
        if (!scrollArea) return;

        function updateFade() {
          const sl = scrollArea.scrollLeft;
          const max = scrollArea.scrollWidth - scrollArea.clientWidth;
          carousel.classList.toggle('hide-left', sl <= 2);
          carousel.classList.toggle('hide-right', sl >= max - 2);
        }
        updateFade();
        scrollArea.addEventListener('scroll', updateFade);

        // --- 일반 캐러셀 마우스 드래그 조작 (Lerp 스무스 스크롤 적용 / Jitter 완벽 해결) ---
        let isDown = false;
        let isDragging = false;
        let startX = 0;
        let lastX = 0;

        // 보간법(Lerp) 변수
        let currentScroll = scrollArea.scrollLeft;
        let targetScroll = scrollArea.scrollLeft;
        let isAnimating = false;

        function smoothScrollLoop() {
          if (!isAnimating) return;

          // 보간 수치를 마키(0.08)와 동일하게 낮춰 부드러움을 극대화
          currentScroll += (targetScroll - currentScroll) * 0.08;
          scrollArea.scrollLeft = currentScroll;

          // 마우스를 쥐고 있거나, 목표 스크롤에 도달하기 전이면 계속 프레임 반복 (관성 유지)
          if (isDown || Math.abs(targetScroll - currentScroll) > 0.5) {
            requestAnimationFrame(smoothScrollLoop);
          } else {
            // 완전히 부드럽게 멈춘 뒤에 스크롤 종료 및 CSS 스냅 개입 허용
            isAnimating = false;
            currentScroll = targetScroll;
            scrollArea.scrollLeft = currentScroll;
            scrollArea.classList.remove('is-dragging');
          }
        }

        scrollArea.addEventListener('mousedown', (e) => {
          isDown = true;
          isDragging = false;
          // is-dragging 클래스 추가 부분을 아래 mousemove로 이동했습니다.
          
          startX = e.pageX;
          lastX = e.pageX;
          
          // 드래그 시작 시점의 위치 동기화
          currentScroll = scrollArea.scrollLeft;
          targetScroll = scrollArea.scrollLeft;

          // 애니메이션 루프 가동
          if (!isAnimating) {
            isAnimating = true;
            requestAnimationFrame(smoothScrollLoop);
          }
        });

        const stopDrag = () => {
          isDown = false;
          // isAnimating = false 및 classList.remove는 
          // smoothScrollLoop 내에서 관성이 완전히 끝난 후 실행되도록 맡깁니다.
        };

        scrollArea.addEventListener('mouseleave', stopDrag);
        scrollArea.addEventListener('mouseup', stopDrag);

        scrollArea.addEventListener('mousemove', (e) => {
          if (!isDown) return;
          e.preventDefault();
          isDragging = true;
          
          // 사용자가 마우스를 실제로 움직이기 시작할 때 클래스를 추가하여
          // 단순 클릭 시 요소들의 이벤트를 차단하지 않도록 수정했습니다.
          scrollArea.classList.add('is-dragging');

          const currentX = e.pageX;
          const diff = lastX - currentX;
          
          // 이동량(Delta)을 타겟 스크롤에 누적
          targetScroll += diff * 1.5;
          
          // 컨테이너 범위를 벗어나지 않도록 타겟 제한 (튕김 현상 방지)
          const maxScroll = scrollArea.scrollWidth - scrollArea.clientWidth;
          targetScroll = Math.max(0, Math.min(targetScroll, maxScroll));
          
          lastX = currentX;
        });

        // 사용자가 터치패드/휠을 사용할 때 충돌하지 않도록 목표점 동기화
        scrollArea.addEventListener('scroll', () => {
          // 스크립트가 애니메이션 중일 때는 동기화를 막아 Jitter 현상 완벽 차단
          if (!isDown && !isAnimating) {
            targetScroll = scrollArea.scrollLeft;
            currentScroll = scrollArea.scrollLeft;
          }
        });

        // 드래그 중 내부 미디어 재생 및 링크 이동 차단
        scrollArea.addEventListener('click', (e) => {
          if (isDragging && Math.abs(startX - e.pageX) > 5) {
            e.preventDefault();
            e.stopPropagation();
          }
        }, { capture: true });
      });

      window.addEventListener('load', () => setupMarquee(1.));
    });
  </script>
</Layout>
