              {frontmatter.statSections[2].source && (
                <div class="section-source">{frontmatter.statSections[2].source}</div>
              )}
            </div>
          )}

          {/* 성과지표 섹션 중 마지막 — 이미지 위주의 본문(Content) 바로 위에 위치 */}
          {frontmatter.clickTable && !frontmatter.clickTable.hidden && (
            <div class="bg-white p-6 sm:p-8 mb-4 card-shell fade-section">
              <div class="stat-eyebrow">
                <span class="title">{frontmatter.clickTable.title}</span>
              </div>
              <div class="click-table-wrap">
                <table class="click-table">
                  <thead>
                    <tr>
                      <th class="align-left">My Campaigns</th>
                      <th>CTR</th>
                      <th>Clicks</th>
                      <th>vs. Avg</th>
                    </tr>
                  </thead>
                  <tbody>
                    {frontmatter.clickTable.rows.map(r => (
                      <tr>
                        <td class="align-left">
                          <div class="click-name">{r.name}</div>
                          <div class="click-detail">{r.detail}</div>
                        </td>
                        <td class="click-ctr">{r.ctr}</td>
                        <td>{r.clicks}</td>
                        <td class="click-mult">{r.mult}</td>
                      </tr>
                    ))}
                    {frontmatter.clickTable.avgRow && (
                      <tr class="is-avg">
                        <td class="align-left">{frontmatter.clickTable.avgRow.name}</td>
                        <td class="click-ctr">{frontmatter.clickTable.avgRow.ctr}</td>
                        <td>{frontmatter.clickTable.avgRow.clicks}</td>
                        <td class="click-mult">{frontmatter.clickTable.avgRow.mult}</td>
                      </tr>
                    )}
                  </tbody>
                </table>
              </div>
            </div>
          )}

          {!frontmatter.hideMarkdownBody && (
            <div class="bg-white p-2 sm:p-4 mb-4 card-shell post-content fade-section">
              <Content />
            </div>
          )}

          {introHtml && (
            <div class="bg-white p-6 sm:p-8 mb-4 card-shell post-content fade-section">
              <div class="prose prose-lg max-w-none text-gray-800" set:html={introHtml} />
            </div>
          )}

          <div class="p-6 sm:p-8 mb-4 card-shell fade-section" style="background: linear-gradient(to bottom, #4e5459, #2c3e50); color: black;">
            <div class="mb-0 flex gap-3 items-center text-white/70 text-[1.2rem]"><span>Got any Questions?</span></div>
            <p class="text-white/90 text-xl !mt-0 !mb-4 leading-tight">
              {siteData.jobTitle} with {siteData.experience}.<br>
              Whether you have a project in mind or a question you’re burning to ask, fire away!
            </p>
            <div class="text-[1rem] mt-3 flex gap-4">
              <a href="/profile" class="text-white/70 underline text-m hover:text-white/30 transition-colors">Profile</a>
              <a href={`mailto:${siteData.email}`} class="text-white/70 underline text-m hover:text-white/30 transition-colors">E-mail</a>
            </div>
          </div>

          {frontmatter.footnotes && (
            <div class="case-footnote fade-section">
              <div class="case-footnote-title">Notes</div>
              <div class="case-footnote-body">
                {frontmatter.footnotes.map(f => <p>{f}</p>)}
              </div>
            </div>
          )}

        </article>
      ) : (
        <article class="prose prose-lg max-w-3xl mx-auto">
          <div class="bg-white px-5 py-5 mb-7 card-shell load-fade">
            <div class="mb-1 flex gap-3 items-center text-gray-400 text-[0.96rem]">
              <span>{frontmatter.date && (new Date(frontmatter.date)).toLocaleDateString('ko-KR', { year: 'numeric', month: 'long', day: 'numeric' })}</span>
              <span class="mx-1">&middot;</span>
              <span>{frontmatter.category}</span>
            </div>
            <h1 class="mb-1">{frontmatter.title}</h1>
            {frontmatter.description && <p class="text-gray-600 text-lg mt-2 mb-3">{frontmatter.description}</p>}
            {frontmatter.image && <img src={frontmatter.image} alt={frontmatter.title} class="square-img" />}
          </div>
          {!frontmatter.hideMarkdownBody && <Content />}
        </article>
      )}
    </div>
  </div>

<style is:global>
    .card-shell { border-radius: 16px; box-shadow: 0px 0px 10px rgba(0, 0, 0, 0.02); overflow: hidden; }

    /* 스크롤로 뷰포트에 들어오는 본문 섹션을 아래→위로 fade in.
       화면을 벗어났다가 다시 들어오면 재생하되, 판정은 transform과 무관한 레이아웃 좌표로 처리 */
    .fade-section {
      opacity: 0;
      transform: translateY(28px);
      transition: opacity 0.7s cubic-bezier(0.22, 1, 0.36, 1),
                  transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);
    }
    .fade-section.is-visible {
      opacity: 1;
      transform: translateY(0);
    }
    /* 처음 두 섹션(헤더/본문)은 스크롤을 기다리지 않고 페이지 진입 시 곧바로 fade in —
       로딩되는 느낌을 주기 위해 본문은 헤더보다 살짝 늦게 뜸 */
    .load-fade {
      opacity: 0;
      transform: translateY(20px);
      transition: opacity 0.6s cubic-bezier(0.22, 1, 0.36, 1),
                  transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
    }
    .load-fade.is-loaded {
      opacity: 1;
      transform: translateY(0);
    }
    .load-fade-2 {
      transition-delay: 0.12s;
    }
    @media (prefers-reduced-motion: reduce) {
      .load-fade { opacity: 1; transform: none; transition: none; }
    }
    /* 고스트 스타일 — 박스 없이 아이콘+텍스트만, 호버 시 화살표가 슬라이드 */
    .back-btn {
      flex-shrink: 0;
      display: inline-flex; align-items: center; gap: 0.35rem;
      padding: 0.3rem 0.1rem;
      background: transparent; border: none;
      color: #111; font-weight: 600; font-size: 0.95rem;
      cursor: pointer;
      transition: opacity 0.15s ease;
    }
    .back-btn svg { width: 1.05rem; height: 1.05rem; transition: transform 0.15s ease; }
    .back-btn:hover { opacity: 0.55; }
    .back-btn:hover svg { transform: translateX(-3px); }
    .back-btn:active svg { transform: translateX(-1px); }
    html, body { background: #ebe9e5; }

    /* --- 캐러셀 & 마키 마우스 드래그 커서 및 충돌 방지 CSS --- */
    .my-carousel-scroll,
    .marquee-mode .marquee-track {
      cursor: grab;
    }
    
    .my-carousel-scroll.is-dragging,
    .marquee-mode .marquee-track.is-dragging {
      cursor: grabbing !important;
    }

    /* 드래그 중 내부 이미지/비디오 선택 방지 및 마우스 간섭 완벽 차단 */
    .my-carousel-scroll.is-dragging *,
    .marquee-mode .marquee-track.is-dragging * {
      pointer-events: none !important;
      user-select: none !important;
    }

    /* --- 마키(Marquee) CSS 최적화 --- */
    .marquee-mode .marquee-track {
      display: flex !important;
      overflow-x: auto !important; 
      scroll-behavior: auto !important; 
      scroll-snap-type: none !important;
      scrollbar-width: none !important;
      -ms-overflow-style: none !important;
      gap: 0 !important;
      will-change: scroll-position;
    }
    .marquee-mode .marquee-track::-webkit-scrollbar { 
      display: none !important;
    }
    
    .marquee-mode .my-carousel-item { 
      flex: 0 0 auto !important;
      margin: 0 !important; 
      padding: 0 !important;
    }
    
    .marquee-mode .my-carousel-img {
      display: block !important;
      max-width: none !important;
      border-radius: 0 !important;
    }

    /* ------------ Role / Scope — 팀 성과와 내 기여를 구분하는 정직성 블록.
       위계는 색/굵기로만: 검정+볼드(핵심) vs 회색+일반(부가) — profile.astro의
       skills-category(1.08rem/700/#111) · skills-tools(0.92rem/#666) · profile-quote(#555)와
       동일한 두 단(black·bold / gray·regular) 체계를 그대로 가져옴. 헤어라인 구분선은
       click-table의 행 구분선(rgba(17,17,17,0.07))과 동일 */
    .role-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 40px;
    }
    /* 컬럼 헤딩 — stat-label과 동일한 위계(1.08rem/700/#111) + 앞에 포인트 링 도트 */
    .role-col-heading {
      display: flex;
      align-items: center;
      gap: 7px;
      font-size: 1.08rem;
      font-weight: 700;
      letter-spacing: -0.01em;
      color: #111;
      line-height: 1.35;
      margin-bottom: 6px;
    }
    .role-col-heading::before {
      content: '';
      width: 7px; height: 7px; border-radius: 50%;
      background: #e4e9f3;
      border: 1.5px solid #5b74a3;
      flex: none;
    }
    /* prose(article) 안이라 전역 ul/li 마진·패딩이 스며듦 — 들여쓰기 완전 제거 */
    .role-list {
      list-style: none;
      margin: 0 !important;
      padding: 0 !important;
    }
    .role-list li {
      margin: 0 !important;
      padding: 13px 0;
      border-bottom: 1px solid rgba(17, 17, 17, 0.07);
    }
    .role-list li:last-child { border-bottom: none; }
    /* 이름 크기는 profile.astro의 lang-level(1.02rem/500/#555)과 동일 기준,
       역할명은 skills-category(1.08rem/700/#111)와 동일 기준 */
    .credit-role {
      font-size: 1.08rem;
      font-weight: 700;
      color: #111;
      letter-spacing: -0.01em;
    }
    .credit-role::after { content: '\2014'; margin: 0 7px; color: #c7c5c0; font-weight: 400; }
    .credit-name { font-size: 1.02rem; font-weight: 500; color: #555; letter-spacing: -0.01em; }
    .credit-suffix { font-size: 0.88rem; font-weight: 400; color: #8a8a8a; margin-left: 4px; }
    .role-list li.is-me {
      margin: 0 -10px !important;
      padding-left: 10px;
      padding-right: 10px;
      background: rgba(91, 116, 163, 0.06);
      border-bottom-color: transparent;
      border-radius: 6px;
    }
    .role-list li.is-me .credit-role { color: #5b74a3; }
    .role-list li.is-me .credit-name { color: #5b74a3; font-weight: 600; }
    /* 스코프 목록 — 불릿·들여쓰기 없이 팀 목록과 같은 헤어라인 행 언어로 통일 */
    .role-list-plain {
      color: #555;
      font-size: 1.02rem;
      font-weight: 500;
      line-height: 1.5;
    }
    .role-list-plain li { display: block; }
    @media (max-width: 640px) {
      /* 1열로 접히면 Team/Scope 두 블록이 붙어 구분이 안 되므로, 둘째 블록(My Scope)에
         상단 헤어라인 + 여백을 줘 명확히 나눔 */
      .role-grid { grid-template-columns: 1fr; gap: 0; }
      .role-col + .role-col {
        margin-top: 22px;
        padding-top: 22px;
        border-top: 1px solid rgba(17, 17, 17, 0.12);
      }
    }

    /* 성과 인포그래픽 — 타이틀/본문과 같은 급의 독립 섹션(card-shell)으로 렌더링됨.
       이 페이지 자체에 이미 있는 큰 타이포(H1 30~36px, description 20px, date행 0.96rem)를
       기준으로 삼음 — profile.astro는 촘촘한 리스트라 절대값을 그대로 가져오면 지나치게
       작아짐. 숫자는 이 섹션의 히어로이므로 H1급으로 크게, 라벨/캡션도 본문 date행 정도의
       무게감은 유지. 포인트 컬러(#5b74a3)는 posts.astro 카드 호버 링과 항상 통일 —
       색 바꿀 땐 둘 다 같이 */
    .stat-eyebrow {
      padding-bottom: 18px;
      margin-bottom: 22px;
      border-bottom: 1px solid rgba(17, 17, 17, 0.15);
