---
import Layout from '../../layouts/Layout.astro';
import { personId, siteData } from '../../data/site';
import { marked } from 'marked'; 
import { readdir } from 'node:fs/promises';
import { resolve, sep } from 'node:path';

export async function getStaticPaths() {
  const postImportResult = import.meta.glob('../../content/posts/*.md');
  const paths = [];
  for (const path in postImportResult) {
    const slug = path.split('/').pop().replace('.md', '');
    paths.push({ params: { slug } });
  }
  return paths;
}

const { default: Content, frontmatter } = await import(`../../content/posts/${Astro.params.slug}.md`);
const isWide = frontmatter.format === 'wide';
const introHtml = frontmatter.intro ? await marked.parse(frontmatter.intro) : null;

// Featured Email 목업 미디어:
// 1) images 배열(명시 순서) → 2) imageFolder(파일명 자연 정렬) → 3) 기존 img 한 장 순으로 해석.
// GIF도 일반 img 요소로 렌더해 자동 재생되며, 여러 파일은 폰 화면 안에서 세로로 이어진다.
const FEATURED_IMAGE_EXT = /\.(?:avif|gif|jpe?g|png|webp)$/i;
const publicAssetRoot = resolve(process.cwd(), 'public');

const normalizeFeaturedImage = (item, label, index) => {
  const fallbackAlt = `${label} — image ${index + 1}`;
  return typeof item === 'string'
    ? { src: item, alt: fallbackAlt }
    : { src: item.src, alt: item.alt || fallbackAlt };
};

const resolveFeaturedImages = async (email) => {
  if (Array.isArray(email.images) && email.images.length) {
    return email.images
      .filter(item => typeof item === 'string' || item?.src)
      .map((item, index) => normalizeFeaturedImage(item, email.label, index));
  }

  if (email.imageFolder) {
    const folderUrl = `/${String(email.imageFolder).replace(/^\/+|\/+$/g, '')}`;
    const folderPath = resolve(publicAssetRoot, folderUrl.slice(1));
    const isInsidePublic = folderPath.startsWith(`${publicAssetRoot}${sep}`);

    if (isInsidePublic) {
      try {
        const files = (await readdir(folderPath, { withFileTypes: true }))
          .filter(entry => entry.isFile() && FEATURED_IMAGE_EXT.test(entry.name))
          .map(entry => entry.name)
          .sort((a, b) => a.localeCompare(b, undefined, { numeric: true, sensitivity: 'base' }));

        if (files.length) {
          return files.map((file, index) => ({
            src: `${folderUrl}/${encodeURIComponent(file)}`,
            alt: `${email.label} — image ${index + 1}`,
          }));
        }
      } catch {
        // 폴더가 아직 업로드되지 않았으면 기존 img fallback을 사용한다.
      }
    }
  }

  return email.img ? [normalizeFeaturedImage(email.img, email.label, 0)] : [];
};

if (frontmatter.featuredEmails?.groups) {
  await Promise.all(frontmatter.featuredEmails.groups.flatMap(group => (
    group.emails.map(async email => {
      email.resolvedImages = await resolveFeaturedImages(email);
    })
  )));
}

// 매출 추이 라인 차트 — frontmatter.revenueTrend.points로부터 SVG 좌표 계산.
// 참고 디자인(Branding Emotional Graph) 기반: 구간 분할 없이 단일 톤의 연속 곡선 하나 +
// 라인 전체 아래 통합 면 그라디언트. 스토리텔링(하락→회복)은 색이 아니라 Takeover 마커와
// 처음 적용한 Catmull-Rom 기반 cubic Bézier 곡률.
const TREND_TENSION = 0.22;

const smoothSegmentPoint = (pts, segmentIndex, t) => {
  const p1 = pts[segmentIndex];
  const p2 = pts[segmentIndex + 1];
  if (!p1 || !p2) return p1 || p2 || { x: 0, y: 0 };
  const p0 = pts[segmentIndex - 1] || p1;
  const p3 = pts[segmentIndex + 2] || p2;
  const c1 = {
    x: p1.x + (p2.x - p0.x) * TREND_TENSION,
    y: p1.y + (p2.y - p0.y) * TREND_TENSION,
  };
  const c2 = {
    x: p2.x - (p3.x - p1.x) * TREND_TENSION,
    y: p2.y - (p3.y - p1.y) * TREND_TENSION,
  };
  const mt = 1 - t;
  return {
    x: mt ** 3 * p1.x + 3 * mt ** 2 * t * c1.x + 3 * mt * t ** 2 * c2.x + t ** 3 * p2.x,
    y: mt ** 3 * p1.y + 3 * mt ** 2 * t * c1.y + 3 * mt * t ** 2 * c2.y + t ** 3 * p2.y,
  };
};

const smoothPointAtX = (pts, targetX) => {
  let segmentIndex = pts.findIndex((p, i) => (
    i < pts.length - 1 && targetX >= p.x && targetX <= pts[i + 1].x
  ));
  if (segmentIndex < 0) segmentIndex = targetX < pts[0].x ? 0 : pts.length - 2;

  let low = 0;
  let high = 1;
  for (let i = 0; i < 24; i++) {
    const mid = (low + high) / 2;
    const point = smoothSegmentPoint(pts, segmentIndex, mid);
    if (point.x < targetX) low = mid;
    else high = mid;
  }
  return smoothSegmentPoint(pts, segmentIndex, (low + high) / 2);
};

const smoothPath = (pts) => {
  if (pts.length < 2) return '';
  if (pts.length === 2) return `M ${pts[0].x},${pts[0].y} L ${pts[1].x},${pts[1].y}`;
  let d = `M ${pts[0].x},${pts[0].y}`;
  for (let i = 0; i < pts.length - 1; i++) {
    const p0 = pts[i - 1] || pts[i];
    const p1 = pts[i];
    const p2 = pts[i + 1];
    const p3 = pts[i + 2] || p2;
    const c1x = p1.x + (p2.x - p0.x) * TREND_TENSION;
    const c1y = p1.y + (p2.y - p0.y) * TREND_TENSION;
    const c2x = p2.x - (p3.x - p1.x) * TREND_TENSION;
    const c2y = p2.y - (p3.y - p1.y) * TREND_TENSION;
    d += ` C ${c1x},${c1y} ${c2x},${c2y} ${p2.x},${p2.y}`;
  }
  return d;
};

// 차트 지오메트리를 계산 — W(뷰박스 너비)를 줄일수록 카드 실제 렌더 너비 대비 스케일이
// 커져서, 같은 px 폰트 크기(CSS)가 화면에 더 크게 찍힌다. 데스크톱/모바일 각각 카드의
// 실제 렌더 너비가 크게 다르므로(약 840px vs 320px) 뷰박스 하나로는 둘 다 만족시킬 수
// 없어 지오메트리 자체를 두 벌 만든다 — 폰트 크기(CSS)는 공유, W/PAD_X/세로 비율만 다름.
// 세로(PLOT_TOP~BOTTOM/H)를 너비 대비 넉넉히 잡아 "위아래로 늘어난" 종횡비를 만들면
// 라벨이 뭉치지 않고 여유롭게 읽힌다(모바일 쪽을 더 정사각형에 가깝게).
function buildTrendChart(trend, geom) {
  const { W, PAD_X, PLOT_TOP, PLOT_BOTTOM, H } = geom;
  const points = trend.points;
  const values = points.map(p => p.value);
  const min = Math.min(...values);
  const max = Math.max(...values);
  // 감성용 padding bias(참고 디자인의 핵심) — 실제 min/max 대신 ±8% 여유를 둔 가상
  // 범위로 매핑해, 최고점이 천장에 닿거나 저점이 바닥에 붙지 않고 라인이 공중에 떠서 흐름
  const visualMax = max * 1.08;
  const visualMin = min * 0.92;
  const range = (visualMax - visualMin) || 1;
  const n = points.length;
  const stepX = (W - PAD_X * 2) / (n - 1);
  const plotH = PLOT_BOTTOM - PLOT_TOP;
  const yFor = (v) => +(PLOT_TOP + (1 - (v - visualMin) / range) * plotH).toFixed(1);
  const coords = points.map((p, i) => ({
    ...p,
    // 월말 저점처럼 축 라벨과 실제 이벤트 시점이 다른 경우, 한 달 간격을 1로 본
    // xOffset으로 데이터 포인트만 미세 조정한다. 월 라벨 위치는 그대로 유지한다.
    tickX: +(PAD_X + stepX * i).toFixed(1),
    x: +(PAD_X + stepX * (i + (p.xOffset ?? 0))).toFixed(1),
    y: yFor(p.value),
  }));

  const troughIdx = values.indexOf(min);
  const lastIdx = n - 1;
  // takeover 같은 전환 시점은 월 데이터 포인트와 별개로 월 사이에도 놓일 수 있다.
  const joinPosition = Math.max(0, Math.min(trend.joinPosition ?? trend.joinIndex ?? troughIdx, lastIdx));
  const joinFromIdx = Math.floor(joinPosition);
  const joinToIdx = Math.min(Math.ceil(joinPosition), lastIdx);
  const joinT = joinPosition - joinFromIdx;
  const joinCoord = Number.isFinite(trend.joinTickPosition)
    ? smoothPointAtX(coords, PAD_X + stepX * Math.max(0, Math.min(trend.joinTickPosition, lastIdx)))
    : joinFromIdx === joinToIdx
      ? coords[joinFromIdx]
      : smoothSegmentPoint(coords, joinFromIdx, joinT);

  // 단일 연속 곡선 + 그 전체를 바닥선까지 닫은 면 — 참고 코드의 linePath/areaPath 그대로
  const linePath = smoothPath(coords);
  const areaPath = `${linePath} L ${coords[lastIdx].x},${PLOT_BOTTOM} L ${coords[0].x},${PLOT_BOTTOM} Z`;

  return {
    W, H, PLOT_TOP, PLOT_BOTTOM,
    coords,
    linePath,
    areaPath,
    troughIdx,
    lastIdx,
    joinCoord,
  };
}

let trendChart = null;
let trendChartMobile = null;
if (frontmatter.revenueTrend?.points?.length > 1) {
  const trend = frontmatter.revenueTrend;
  // 플롯이 카드 콘텐츠 폭에 꽉 차도록 PAD_X를 작게 — 양 끝 값/월 라벨은 마크업에서
  // start/end 정렬로 처리해 가장자리에서 잘리지 않음. 데스크톱/모바일 모두 완만한
  // 비율(plot 높이/가로폭 ≈ 0.3)로 곡선 인상 통일
  trendChart = buildTrendChart(trend, { W: 640, PAD_X: 14, PLOT_TOP: 52, PLOT_BOTTOM: 214, H: 282 });
  trendChartMobile = buildTrendChart(trend, { W: 340, PAD_X: 12, PLOT_TOP: 52, PLOT_BOTTOM: 152, H: 206 });
}

const projectURL = `${siteData.url}${Astro.url.pathname}`;
const projectSchema = {
  '@type': 'CreativeWork',
  '@id': `${projectURL}#project`,
  name: frontmatter.title,
  description: frontmatter.description,
  url: projectURL,
  image: frontmatter.image ? new URL(frontmatter.image, siteData.url).href : undefined,
  dateCreated: frontmatter.date,
  genre: Array.isArray(frontmatter.category) ? frontmatter.category : [frontmatter.category].filter(Boolean),
  creator: { '@id': personId },
};
---

<Layout
  title={`${siteData.name} | ${frontmatter.title}`}
  description={frontmatter.description || siteData.description}
  image={frontmatter.image || siteData.image}
  type="article"
  schema={projectSchema}
>
  <div class="pt-3 sm:pt-0 lg:pt-4 lg:relative bg-[#ebe9e5] min-h-screen">
    <!-- 충분한 좌측 여백이 생기는 2xl부터만 버튼을 바깥 레일에 배치하고,
         그보다 좁은 화면에서는 본문 위의 정상 플로우에 두어 콘텐츠와 겹치지 않게 함 -->
    <div class="flex flex-wrap gap-x-4 gap-y-2 mb-3 px-3 sm:px-6 2xl:mb-0 2xl:px-0 2xl:absolute 2xl:top-4 2xl:left-6 justify-start items-center">
      <button onclick="window.history.back()" class="back-btn mr-6">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5"/><path d="M11 18l-6-6 6-6"/></svg>
        Projects
      </button>
    </div>

    <div class="px-3 sm:px-6">
      {isWide ?
      (
        <article class="prose prose-lg w-full max-w-[1100px] mx-auto">
          <!-- 처음 두 섹션(헤더/본문)은 스크롤을 기다리지 않고, 로딩되듯 페이지 진입 시 바로 fade in -->
          <div class="bg-white p-6 sm:p-8 mb-4 card-shell load-fade">
            <div class="mb-2 flex flex-wrap items-center text-gray-400 text-[0.96rem] gap-y-1">
              <div class="flex items-center">
                <span>{frontmatter.date && (new Date(frontmatter.date)).toLocaleDateString('ko-KR', { year: 'numeric', month: 'long', day: 'numeric' })}</span>
                <span class="mx-3 hidden sm:inline">&middot;</span>
              </div>
              <span class="whitespace-normal">{Array.isArray(frontmatter.category) ? frontmatter.category.join(' · ') : frontmatter.category}</span>
            </div>
            <h1 class="!text-3xl sm:!text-4xl font-bold !mb-1">{frontmatter.title}</h1>
            {frontmatter.description && <p class="text-gray-600 text-xl !mt-1 !mb-0">{frontmatter.description}</p>}
          </div>

          {frontmatter.role && (
            <div class="bg-white p-6 sm:p-8 mb-4 card-shell load-fade load-fade-2">
              <div class="stat-eyebrow">
                <span class="title">Team & Scope</span>
              </div>
              <div class="role-grid">
                <div class="role-col">
                  <div class="role-col-heading">
                    Team{frontmatter.role.agency && <> · {frontmatter.role.agency}</>}
                  </div>
                  <ul class="role-list">
                    {frontmatter.role.team.map(person => (
                      <li class:list={{ 'is-me': person.mine }}>
                        <span class="credit-role">{person.part}</span>
                        <span class="credit-name">{person.name}</span>
                        {person.suffix && <span class="credit-suffix">({person.suffix})</span>}
                      </li>
                    ))}
                  </ul>
                </div>
                <div class="role-col">
                  <div class="role-col-heading">My Scope</div>
                  <ul class="role-list role-list-plain">
                    {frontmatter.role.scope.map(item => (
                      <li>{item}</li>
                    ))}
                  </ul>
                </div>
              </div>
            </div>
          )}

          {/* Revenue 차트 + statSections[0](Team Result)를 한 카드로 통합 — 차트가 먼저, 세부 스탯이 그 아래 */}
          {frontmatter.statSections?.[0] && (
            <div class="bg-white p-6 sm:p-8 mb-4 card-shell fade-section">
              <div class="chart-eyebrow">
                <span class="title">{frontmatter.statSections[0].title}</span>
              </div>

              {trendChart && trendChartMobile && (
                <>
                  <div class="trend-unit-label">{frontmatter.revenueTrend.unit}</div>
                  {[
                    { chart: trendChart, wrapClass: 'trend-svg-wrap hidden sm:block', idSuffix: 'desktop' },
                    { chart: trendChartMobile, wrapClass: 'trend-svg-wrap sm:hidden', idSuffix: 'mobile' },
                  ].map(({ chart, wrapClass, idSuffix }) => (
                    <div class={`${wrapClass} trend-plot`}>
                      {/* SVG에는 선·면·도트만 — 텍스트는 아래 HTML 오버레이로 분리해 컨테이너
                          폭에 따라 스케일되지 않고 항상 고정 크기(rem)를 유지하게 함 */}
                      <svg viewBox={`0 0 ${chart.W} ${chart.H}`} class="trend-svg" role="img"
                           aria-label={`Monthly revenue trend — ${frontmatter.revenueTrend.joinLabel}, trough ${frontmatter.revenueTrend.troughLabel}, peak ${frontmatter.revenueTrend.peakLabel}`}>
                        <defs>
                          {/* 색상은 좌→우(회색 #5F6E7A → 포인트 컬러 #5b74a3)로 —
                              하락기의 무채색이 회복기의 브랜드 컬러로 번져가는 스토리.
                              데스크톱/모바일 두 SVG가 한 문서에 같이 있으므로 id는 반드시
                              variant별로 달라야 함 — 겹치면 뒤에 있는 SVG의 url() 참조가
                              깨짐(문서 순서상 첫 id로만 resolve) */}
                          <linearGradient id={`trendColorGrad-${idSuffix}`} x1="0" y1="0" x2="1" y2="0">
                            <stop offset="0%" stop-color="#5F6E7A" />
                            <stop offset="100%" stop-color="#5b74a3" />
                          </linearGradient>
                          {/* 상하 페이드(0.55→0.22→0)는 마스크로 유지 — 좌우 색 그라디언트와
                              상하 투명도 페이드를 한 면에 겹쳐 얹는 구조 */}
                          <linearGradient id={`trendFadeGrad-${idSuffix}`} x1="0" y1="0" x2="0" y2="1">
                            <stop offset="0%" stop-color="#ffffff" stop-opacity="0.55" />
                            <stop offset="50%" stop-color="#ffffff" stop-opacity="0.22" />
                            <stop offset="100%" stop-color="#ffffff" stop-opacity="0" />
                          </linearGradient>
                          <mask id={`trendFadeMask-${idSuffix}`}>
                            <rect x="0" y="0" width={chart.W} height={chart.H} fill={`url(#trendFadeGrad-${idSuffix})`} />
                          </mask>
                        </defs>

                        <path class="trend-area" d={chart.areaPath}
                              style={`fill: url(#trendColorGrad-${idSuffix}); mask: url(#trendFadeMask-${idSuffix})`} />
                        <path class="trend-line" d={chart.linePath} pathLength="100"
                              style={`stroke: url(#trendColorGrad-${idSuffix})`} />

                        {/* 전체 추이의 양 끝과 비교 기준 시작점에만 흰 도트 */}
                        {chart.coords.map((c, i) => (i === 0 || i === chart.lastIdx || c.showDot) && (
                          <circle cx={c.x} cy={c.y} r="3" class="trend-dot" vector-effect="non-scaling-stroke"
                                  class:list={{ 'dot-end': i === chart.lastIdx }} />
                        ))}

                        {/* takeover 말풍선의 꼬리가 가리키는 전환 시점 */}
                        <circle cx={chart.joinCoord.x} cy={chart.joinCoord.y} r="3" class="trend-dot dot-takeover"
                                vector-effect="non-scaling-stroke" />

                        {/* 값 표시용 호버 타깃 */}
                        {chart.coords.map((c) => (
                          <circle cx={c.x} cy={c.y} r="12" class="trend-hit">
                            <title>{c.month}: ${c.value.toLocaleString()}</title>
                          </circle>
                        ))}
                      </svg>

                      {/* ── HTML 오버레이 (SVG 밖, 고정 rem) — % 위치로 데이터 포인트에 정렬 ── */}
                      {/* 월 라벨 — 플롯 하단에. 양 끝은 start/end 정렬로 가장자리 클리핑 방지 */}
                      {chart.coords.map((c, i) => (
                        <span class="trend-ovl trend-ovl-month"
                              class:list={{ 'ovl-start': i === 0, 'ovl-end': i === chart.lastIdx }}
                              style={`left:${(c.tickX / chart.W * 100).toFixed(2)}%; top:${(chart.PLOT_BOTTOM / chart.H * 100).toFixed(2)}%`}>
                          {c.month}
                        </span>
                      ))}
                      {/* 값 라벨 — 전체 추이의 시작·끝과 비교 기준 시작점(showValue)을 표시.
                          양 끝은 둘 중 더 높은 지점 y에 맞춰 같은 높이로 정렬한다. */}
                      {chart.coords.map((c, i) => (i === 0 || i === chart.lastIdx || c.showValue) && (
                        <span class="trend-ovl trend-ovl-value"
                              class:list={{ 'ovl-start': i === 0, 'ovl-end': i === chart.lastIdx }}
                              style={`left:${(c.x / chart.W * 100).toFixed(2)}%; top:${(((i === 0 || i === chart.lastIdx) ? Math.min(chart.coords[0].y, chart.coords[chart.lastIdx].y) : c.y) / chart.H * 100).toFixed(2)}%`}>
                          ${c.value.toLocaleString()}
                        </span>
                      ))}
                      {/* takeover 말풍선 — 월별 데이터 포인트와 독립적으로 월 사이에 배치 */}
                      <span class="trend-ovl trend-ovl-bubble"
                            style={`left:${(chart.joinCoord.x / chart.W * 100).toFixed(2)}%; top:${(chart.joinCoord.y / chart.H * 100).toFixed(2)}%`}>
                        {frontmatter.revenueTrend.joinLabel}
                      </span>
                    </div>
                  ))}
                </>
              )}

              <div class="stat-grid stat-grid-chart">
                {frontmatter.statSections[0].stats.map(s => (
                  <div class="stat-card">
                    <div class="stat-label">{s.label}</div>
                    <div class="stat-number">{s.prefix && <span class="plus">{s.prefix}</span>}{s.value}<span class="unit" class:list={{ 'unit-x': s.unit === 'x' }}>{s.unit}</span></div>
                    <div class="stat-detail">{s.detail}</div>
                  </div>
                ))}
              </div>

              {frontmatter.statSections[0].subtitle && (
