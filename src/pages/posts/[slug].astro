    }
    .chart-eyebrow .subtitle {
      display: block;
      margin-top: 10px;
      font-size: 0.95rem;
      font-weight: 500;
      letter-spacing: -0.01em;
      color: #8a8a8a;
    }

    /* ------------ 클릭률 테이블 ------------
       모노스페이스는 사이트 어디에도 없는 폰트라 걷어냄 — 본문 산세리프 + tabular-nums로
       숫자 열 정렬만 유지(profile.astro의 숫자 표기 방식과 동일) */
    .click-table-wrap { overflow-x: auto; -webkit-overflow-scrolling: touch; }
