---
import '../styles/global.css';
import Analytics from '@vercel/analytics/astro';
import {
  personStructuredData,
  siteData,
  websiteStructuredData,
} from '../data/site';

const {
  title = `${siteData.name} | ${siteData.jobTitle}`,
  description = siteData.description,
  image = siteData.image,
  type = 'website',
  schema = null,
} = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, siteData.url).href;
const socialImageURL = new URL(image, siteData.url).href;
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    personStructuredData,
    websiteStructuredData,
    ...(schema ? (Array.isArray(schema) ? schema : [schema]) : []),
  ],
};
const showNav = Astro.url.pathname !== '/';
const showFooter = Astro.url.pathname !== '/';

// 햄버거 메뉴의 프로젝트 카테고리 목록 — posts.astro와 동일한 정렬 기준
const postFiles = Object.entries(import.meta.glob('../content/posts/*.md', { eager: true }));
const menuPosts = postFiles.map(([, f]) => f.frontmatter);
const menuCategoryOrder = ['Marketing', 'E-commerce', 'Branding', 'Motion & Content', 'Print & Illustration', 'Events'];
const menuRawCategories = [...new Set(menuPosts.flatMap(p => Array.isArray(p.category) ? p.category : (p.category ? [p.category] : [])))];
const menuCategories = [...menuCategoryOrder.filter(c => menuRawCategories.includes(c)), ...menuRawCategories.filter(c => !menuCategoryOrder.includes(c))];
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={`${siteData.name} (${siteData.alternateName})`} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <link rel="canonical" href={canonicalURL} />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={siteData.siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={socialImageURL} />
    <meta property="og:image:alt" content={`${siteData.name} — ${siteData.jobTitle}`} />
    <meta property="og:locale" content="en_US" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageURL} />

    <script type="application/ld+json" set:html={JSON.stringify(structuredData)}></script>

    <link rel="icon" type="image/svg+xml" href="/images/website/logo.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="512x512" href="/favicon-512.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <style is:global>
      main { flex: 1 1 auto; min-height: 0; }
      /* 그리드 내부 비디오 오버레이 중앙 정렬 교정 */
      .img-col .carousel-video-overlay {
        bottom: 0 !important;
      }

      /* 마우스를 따라 기울어지는 카드 (전역) — setupTiltCards()가 transform을 담당 */
      .tilt-card {
        will-change: transform;
      }
    </style>

    <style>
      :root{
        --nav-radius: 16px; 
        --nav-pad-x: 27px;  
        --nav-pad-t: 22px;  
        --nav-pad-b: 22px;  
        --nav-side-gap: 24px; 
        --nav-gradient: linear-gradient(
          to bottom,
          #040404 0%,
          #040404 18%,
          #13151e 34%,
          #2f3756 50%,
          #747e89 80%,
          #c3c0ba 100%
        );
      }
      .layout-root {
        background: #ebe9e5;
        min-height: 100vh;
      }

      .site-nav{
        position: sticky; top: 0; z-index: 50;
        background: transparent; 
        padding-top: 0; padding-left: 0; padding-right: 0; padding-bottom: 0;
      }

      .site-nav-box{
        position: relative;
        display:flex;
        justify-content:space-between;
        align-items:center;
        margin: 0 max(var(--nav-side-gap), env(safe-area-inset-left)) 0 max(var(--nav-side-gap), env(safe-area-inset-right));
        background: var(--nav-gradient);
        border-radius: 0 0 var(--nav-radius) var(--nav-radius); 
        padding: var(--nav-pad-t) var(--nav-pad-x) var(--nav-pad-b);
        box-sizing: border-box;
        -webkit-transform: translateZ(0);
        /* 두번째 그림자(0 -4px 0 0)는 press 애니메이션 때 박스가 아래로 밀리며 위쪽에
           실선처럼 드러나는 배경색 틈을 그라디언트 시작색으로 미리 메꿔주는 백킹 레이어 —
           박스 자체가 항상 그 위를 덮고 있어서 평소엔 안 보이고 눌렸을 때만 틈을 채움 */
        box-shadow: 0px 0px 10px rgba(0, 0, 0, 0.18), 0 -4px 0 0 #040404;
        transition: box-shadow 0.25s ease, transform 0.25s ease;
      }

      .site-nav-box:hover {
        box-shadow: 6px 6px 10px rgba(0, 0, 0, 0.18), 0 -4px 0 0 #040404;
        transform: translateY(-2px);
      }

      /* 클릭 시 살짝 눌리는 상하 피드백 */
      .site-nav-box:active {
        box-shadow: 0px 0px 6px rgba(0, 0, 0, 0.18), 0 -4px 0 0 #040404;
        transform: translateY(2px);
      }

      .site-brand{
        display:flex; align-items:center; gap: 14px; min-width:0;
        text-decoration:none; color:#fff;
      }
      .brand-logo{
        height: 34px; width:auto; object-fit:contain; border-radius:0;
        filter: invert(1) brightness(1.05) contrast(1.05);
      }
      .brand-title{
        font-weight:500; font-size: 25px;
        letter-spacing:0.01em; word-spacing:-2px; line-height:1; white-space:nowrap; color:#fff;
        overflow:hidden; text-overflow:ellipsis;
        position: relative; top: 2px;
      }

      #menu-wrap{ flex: 0 0 auto; }

      #menu-toggle{
        display:flex; align-items:center; justify-content:center;
        width: 2.75rem; height: 2.75rem;
        border-radius: 9999px; border: 0; cursor:pointer;
        background: transparent; color:#fff;
        transition: opacity .2s;
      }
      #menu-toggle:hover{ opacity: 0.75; }
      #menu-toggle svg{ width:1.7rem; height:1.7rem; stroke-width: 2.6; }

      /* 옆은 nav-box 오른쪽 끝에 정확히 맞추고, 윗부분만 nav<>카드 사이 여백에 살짝 걸치게 */
      #menu-panel{
        position:absolute; top: calc(100% + 8px); right: 0;
        min-width: 13rem;
        background: #fff; color:#111;
        border-radius: 16px;
        box-shadow: 0 20px 45px -12px rgba(0,0,0,0.35), 0 4px 14px rgba(0,0,0,0.1);
        padding: 0.5rem;
        opacity:0; visibility:hidden; transform: translateY(-14px);
        transition: opacity .22s ease,
                    transform .32s cubic-bezier(0.22, 1, 0.36, 1),
                    visibility .32s;
        z-index: 60;
      }
      #menu-wrap.is-open #menu-panel{
        opacity:1; visibility:visible; transform: translateY(0);
      }

      /* 패널 안 항목들이 순차적으로 떠오르는 캐스케이드 — 닫힐 땐 지연 없이 한번에 */
      .menu-panel-item{
        opacity:0; transform: translateY(-5px);
        transition: opacity .2s ease, transform .2s ease;
      }
      #menu-wrap.is-open .menu-panel-item{ opacity:1; transform: translateY(0); }
      #menu-wrap.is-open .menu-panel-item:nth-child(1){ transition-delay: 0.02s; }
      #menu-wrap.is-open .menu-panel-item:nth-child(2){ transition-delay: 0.05s; }
      #menu-wrap.is-open .menu-panel-item:nth-child(3){ transition-delay: 0.08s; }
      #menu-wrap.is-open .menu-panel-item:nth-child(4){ transition-delay: 0.11s; }
      #menu-wrap.is-open .menu-panel-item:nth-child(5){ transition-delay: 0.14s; }
      #menu-wrap.is-open .menu-panel-item:nth-child(6){ transition-delay: 0.17s; }
      #menu-wrap.is-open .menu-panel-item:nth-child(7){ transition-delay: 0.20s; }
      #menu-wrap.is-open .menu-panel-item:nth-child(8){ transition-delay: 0.23s; }
      #menu-wrap.is-open .menu-panel-item:nth-child(9){ transition-delay: 0.26s; }

      .menu-link{
        display:block; padding: 0.55rem 0.8rem; border-radius: 9px;
        font-weight:600; font-size:0.95rem; color:#111; text-decoration:none;
        transition: background .15s ease, transform .15s ease;
      }
      .menu-link:hover{ background: rgba(0,0,0,0.06); transform: translateX(2px); }

      .menu-section-label{
        padding: 0.7rem 0.8rem 0.3rem; margin-top: 0.2rem;
        font-size: 0.72rem; font-weight:700; letter-spacing:0.06em;
        text-transform:uppercase; color: rgba(0,0,0,0.4);
        border-top: 1px solid rgba(0,0,0,0.08);
      }
      .menu-link.menu-sub{ font-weight:500; font-size:0.9rem; color:#333; }

      @media (max-width: 640px){
        .site-nav-box{ margin-inline: max(12px, env(safe-area-inset-left)); }

        #menu-panel{ min-width: 14rem; padding: 0.6rem; }
        .menu-link{ padding: 0.85rem 1rem; font-size: 1.02rem; }
        .menu-section-label{ padding: 0.85rem 1rem 0.35rem; }
        .menu-link.menu-sub{ font-size: 0.98rem; }
      }
    </style>
  </head>

  <body>
    <div class="layout-root">
      {showNav && (
        <nav class="site-nav">
          <div class="site-nav-box">
            <a href="/" class="site-brand" aria-label="홈">
              <img src="/images/website/logo.svg" alt="로고" class="brand-logo" />
              <span class="brand-title">Han Park</span>
            </a>

            <div id="menu-wrap">
              <button id="menu-toggle" type="button" aria-label="메뉴" aria-expanded="false">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <line x1="4" y1="5.5" x2="20" y2="5.5" stroke-width="2" stroke-linecap="round"/>
                  <line x1="4" y1="12" x2="20" y2="12" stroke-width="2" stroke-linecap="round"/>
                  <line x1="4" y1="18.5" x2="20" y2="18.5" stroke-width="2" stroke-linecap="round"/>
                </svg>
              </button>
              <div id="menu-panel">
                <a href="/profile" class="menu-link menu-panel-item">Profile</a>
                <div class="menu-section-label menu-panel-item">Sort</div>
                <a href="/posts?cat=all" class="menu-link menu-sub menu-panel-item">All Projects</a>
                {menuCategories.map(c => (
                  <a href={`/posts?cat=${encodeURIComponent(c)}`} class="menu-link menu-sub menu-panel-item">{c}</a>
                ))}
              </div>
            </div>
          </div>
        </nav>
      )}

      <main>
        <slot />
      </main>

      {showFooter && (
        <footer style="
          background: #F8F8FF;
          border-top: 1px solid #eee;
          text-align: center;
          color: #999;
          font-size: 0.8rem;
          padding: 0.6rem 0 0.6rem 0;
          margin-top: 0;
          flex-shrink: 0;
        ">
          © {new Date().getFullYear()} {siteData.name} | All rights reserved. | {siteData.email}
        </footer>
      )}
    </div>

    <Analytics/>

    <script>
      function enhanceVideo(video) {
        const isCarousel = video.classList.contains('my-carousel-img');

        if (isCarousel) {
          const existingWrapper = video.closest('.video-wrapper');
          if (existingWrapper) {
            const parent = existingWrapper.parentNode;
            if (parent) {
              parent.insertBefore(video, existingWrapper);
            }
            existingWrapper.remove();
          }

          // 캐러셀 아이템 혹은 그리드(img-col) 컨테이너 탐색
          const container = video.closest('.my-carousel-item') || video.closest('.img-col');
          if (container && !container.querySelector('.carousel-video-overlay')) {
            const overlay = document.createElement('div');
            overlay.className = 'carousel-video-overlay';
            container.appendChild(overlay);
          }
          return null;
        }

        let wrapper = video.closest('.video-wrapper');
        if (wrapper) return wrapper;

        wrapper = document.createElement('div');
        wrapper.className = 'video-wrapper';

        const parent = video.parentNode;
        if (!parent) return null;

        parent.insertBefore(wrapper, video);
        wrapper.appendChild(video);

        const overlay = document.createElement('div');
        overlay.className = 'video-play-overlay';
        wrapper.appendChild(overlay);

        let hasPlayed = false;
        const syncOverlay = () => {
          if (video.paused) {
            if (hasPlayed) wrapper.classList.add('is-paused');
            wrapper.classList.remove('is-playing');
          } else {
            hasPlayed = true;
            wrapper.classList.add('is-playing');
            wrapper.classList.remove('is-paused');
          }
        };

        video.addEventListener('play', syncOverlay);
        video.addEventListener('pause', syncOverlay);
        video.addEventListener('ended', () => {
          hasPlayed = false;
          syncOverlay();
        });

        syncOverlay();
        return wrapper;
      }

      function setupVideoControls() {
        const videos = document.querySelectorAll('video');

        videos.forEach((video) => {
          // 자체 재생 로직 또는 장식 용도의 영상은 일반 콘텐츠용 컨트롤 처리에서 제외
          if (
            video.classList.contains('hero-logo-video') ||
            video.classList.contains('decorative-video')
          ) return;

          const isCarousel = video.classList.contains('my-carousel-img');

          if (video.hasAttribute('controls')) {
            video.removeAttribute('controls');
          }

          video.setAttribute('playsinline', '');
          video.setAttribute('webkit-playsinline', '');

          enhanceVideo(video);

          if (video.dataset.hasListener) return;

          if (isCarousel) {
            const container = video.closest('.my-carousel-item') || video.closest('.img-col');
            const overlay = container ? container.querySelector('.carousel-video-overlay') : null;
            let hasPlayed = false;

            const syncCarouselOverlay = () => {
              if (!overlay) return;
              if (!hasPlayed && video.paused) {
                overlay.classList.remove('is-playing', 'is-paused');
              } else if (!video.paused) {
                hasPlayed = true;
                overlay.classList.add('is-playing');
                overlay.classList.remove('is-paused');
              } else {
                overlay.classList.remove('is-playing');
                overlay.classList.add('is-paused');
              }
            };

            video.addEventListener('play', syncCarouselOverlay);
            video.addEventListener('pause', syncCarouselOverlay);
            video.addEventListener('ended', () => {
              hasPlayed = false;
              syncCarouselOverlay();
            });

            syncCarouselOverlay();
          }

          video.addEventListener('click', function (e) {
            e.preventDefault();
            e.stopPropagation();

            if (video.paused) {
              // 클릭 시 음소거 해제 후 재생
              video.muted = false;
              video.play();
            } else {
              video.pause();
            }
          });

          video.addEventListener('dblclick', function (e) {
            e.preventDefault();
          });

          video.dataset.hasListener = 'true';
        });
      }

      function setupAntiCopy() {
        document.addEventListener('contextmenu', e => e.preventDefault());
        function applyNoDrag() {
          document.querySelectorAll('img, video').forEach((el) => {
            el.setAttribute('draggable', 'false');
          });
        }
        applyNoDrag();
        document.addEventListener('keydown', function (e) {
          const key = e.key.toLowerCase();
          if ((e.ctrlKey || e.metaKey) && ['s', 'p', 'u', 'c'].includes(key)) e.preventDefault();
          if (key === 'f12') e.preventDefault();
        });
      }

      // 복사 방지 활성화 상태.
      const ANTI_COPY_ENABLED = true;

      // 카드 자체는 기울지 않고, 안의 이미지만 마우스를 따라 패럴랙스 이동 (.parallax-card)
      function setupParallaxOnlyCards() {
        const isTouch = ('ontouchstart' in window) || (navigator.maxTouchPoints > 0);
        if (isTouch) return;

        const IMG_SCALE = 1.12;
        const IMG_PAN = 1.5; // %

        document.querySelectorAll('.parallax-card').forEach((card) => {
          if (card.dataset.parallaxInit) return;
          card.dataset.parallaxInit = 'true';

          const thumb = card.querySelector('.tilt-card-thumb');
          if (!thumb) return;

          card.addEventListener('mouseenter', () => {
            thumb.style.transition = 'transform 0.15s ease-out';
          });

          card.addEventListener('mousemove', (e) => {
            const rect = card.getBoundingClientRect();
            const dx = ((e.clientX - rect.left) / rect.width - 0.5) * 2;
            const dy = ((e.clientY - rect.top) / rect.height - 0.5) * 2;
            const panX = -dx * IMG_PAN;
            const panY = -dy * IMG_PAN;
            thumb.style.transform = `scale(${IMG_SCALE}) translate(${panX}%, ${panY}%)`;
          });

          card.addEventListener('mouseleave', () => {
            thumb.style.transition = 'transform 0.5s cubic-bezier(0.22, 1, 0.36, 1)';
            thumb.style.transform = '';
          });
        });
      }

      function setupTiltCards() {
        const isTouch = ('ontouchstart' in window) || (navigator.maxTouchPoints > 0);
        if (isTouch) return;

        const MAX_TILT = 7; // deg (전체 강도 — 마우스가 올라간 카드에만 적용)
        const LIFT = 6; // px
        const IMG_SCALE = 1.12; // 썸네일 기본 확대 — 패럴랙스로 움직여도 빈 여백 안 보이게
        const IMG_PAN = 1.7; // %, 썸네일이 반대 방향으로 시차 이동하는 폭

        document.querySelectorAll('.tilt-card').forEach((card) => {
          if (card.dataset.tiltInit) return;
          card.dataset.tiltInit = 'true';

          let pressed = false;
          let lastDx = 0, lastDy = 0;
          const thumb = card.querySelector('.tilt-card-thumb');

          function apply(dx, dy) {
            lastDx = dx; lastDy = dy;
            const rotY = dx * MAX_TILT;
            const rotX = -dy * MAX_TILT;
            const scale = pressed ? 0.98 : 1.02;
            card.style.transform =
              `perspective(800px) rotateX(${rotX}deg) rotateY(${rotY}deg) translateY(-${LIFT}px) scale(${scale})`;
            if (thumb) {
              const panX = -dx * IMG_PAN;
              const panY = -dy * IMG_PAN;
              thumb.style.transform = `scale(${IMG_SCALE}) translate(${panX}%, ${panY}%)`;
            }
          }

          // 카드의 CSS transition(box-shadow 등)을 인라인으로 덮어쓰지 않도록
          // transform 속도만 바꿀 때도 box-shadow transition은 항상 같이 명시
          const RING_T = 'box-shadow 0.32s cubic-bezier(0.22, 1, 0.36, 1)';

          card.addEventListener('mouseenter', () => {
            card.style.transition = `transform 0.15s ease-out, ${RING_T}`;
            if (thumb) thumb.style.transition = 'transform 0.15s ease-out';
          });

          card.addEventListener('mousemove', (e) => {
            const rect = card.getBoundingClientRect();
            const dx = ((e.clientX - rect.left) / rect.width - 0.5) * 2;
            const dy = ((e.clientY - rect.top) / rect.height - 0.5) * 2;
            apply(dx, dy);
          });

          // mousedown/up 시점에 마우스가 멈춰있어도(=mousemove 없이도) 눌림 피드백이 즉시 보이도록
          card.addEventListener('mousedown', () => {
            pressed = true;
            card.style.transition = `transform 0.08s ease-out, ${RING_T}`;
            apply(lastDx, lastDy);
          });
          card.addEventListener('mouseup', () => {
            pressed = false;
            card.style.transition = `transform 0.15s ease-out, ${RING_T}`;
            apply(lastDx, lastDy);
          });

          card.addEventListener('mouseleave', () => {
            pressed = false;
            card.style.transition = `transform 0.5s cubic-bezier(0.22, 1, 0.36, 1), ${RING_T}`;
            card.style.transform = '';
            if (thumb) {
              thumb.style.transition = 'transform 0.5s cubic-bezier(0.22, 1, 0.36, 1)';
              thumb.style.transform = '';
            }
          });
        });
      }

      // 모바일(터치) 전용: 화면 중앙에 가까운 카드일수록 썸네일이 상하로만 시차 이동
      function setupScrollParallax() {
        const isTouch = ('ontouchstart' in window) || (navigator.maxTouchPoints > 0);
        if (!isTouch) return;
        if (window.__scrollParallaxBound) return;
        window.__scrollParallaxBound = true;

        const IMG_SCALE = 1.12;
        const PAN = 4; // %, 상하로만

        let ticking = false;
        function update() {
          const viewportCenter = window.innerHeight / 2;
          document.querySelectorAll('.tilt-card-thumb').forEach((thumb) => {
            const card = thumb.closest('.tilt-card');
            if (!card) return;
            const rect = card.getBoundingClientRect();
            if (rect.height === 0) return;
            const cardCenter = rect.top + rect.height / 2;
            const dy = Math.max(-1, Math.min(1, (viewportCenter - cardCenter) / (rect.height / 2)));
            thumb.style.transform = `scale(${IMG_SCALE}) translateY(${dy * PAN}%)`;
          });
          ticking = false;
        }

        // window의 scroll이 아니라 document를 캡처 단계에서 들어야 함 —
        // 이 사이트는 html/body가 각자 overflow-y:auto를 갖는 중첩 스크롤 구조라
        // 모바일에서 실제로 스크롤되는 건 body(또는 그 안쪽 컨테이너)이고,
        // scroll 이벤트는 버블링되지 않아 window 리스너까지 안 올라옴
        document.addEventListener('scroll', () => {
          if (ticking) return;
          ticking = true;
          requestAnimationFrame(update);
        }, { passive: true, capture: true });

        update();
      }

      // 모바일(터치) 전용: 카드 탭 시 스케일+링 하이라이트로 눌림 피드백을 준 뒤 이동 —
      // 데스크톱의 setupTiltCards()는 터치에서 아예 동작하지 않아(hover 기반) 탭해도
      // 아무 반응이 없었던 문제를 보완
      function setupTouchCardFeedback() {
        const isTouch = ('ontouchstart' in window) || (navigator.maxTouchPoints > 0);
        if (!isTouch) return;

        document.querySelectorAll('.tilt-card').forEach((card) => {
          if (card.dataset.touchFeedbackInit) return;
          card.dataset.touchFeedbackInit = 'true';

          card.addEventListener('touchstart', () => {
            card.classList.add('is-touch-active');
          }, { passive: true });
          // touchend에서는 끄지 않음 — 탭을 끝까지 완료했으면 곧 이동할 거라
          // 여기서 껐다가 click 핸들러가 다시 켜면 깜빡이는 것처럼 보임.
          // 제스처가 중간에 취소된 경우(손가락을 밀어서 뺌)에만 원상복구
          card.addEventListener('touchcancel', () => {
            card.classList.remove('is-touch-active');
          }, { passive: true });

          // 피드백이 눈에 보일 시간을 확보한 뒤 이동 (탭 즉시 페이지가 넘어가버리면
          // 스케일/링 효과가 그려질 틈도 없이 사라짐)
          const href = card.getAttribute('href');
          if (href) {
            // 클로저 변수 대신 dataset에 저장 — bfcache로 페이지가 복원될 때(pageshow) 밖에서 리셋 가능해야 함
            card.dataset.navigating = 'false';
            card.addEventListener('click', (e) => {
              e.preventDefault();
              if (card.dataset.navigating === 'true') return; // 일부 모바일 브라우저에서 click이 중복 발생해 두 번 이동하는 것 방지
              card.dataset.navigating = 'true';
              card.classList.add('is-touch-active');
              setTimeout(() => { window.location.href = href; }, 130);
            });
          }
        });
      }

      // 모바일에서 뒤로가기로 돌아오면 브라우저가 페이지를 bfcache에서 그대로 복원하는데,
      // 이 경우 DOMContentLoaded가 다시 발생하지 않아 위의 navigating 플래그가 true로 남아있는 채였음 —
      // 그래서 뒤로가기 후 같은 카드를 다시 눌러도 클릭이 씹히는 버그가 있었음. pageshow로 복원 감지 후 리셋.
      window.addEventListener('pageshow', (e) => {
        if (!e.persisted) return;
        document.querySelectorAll('.tilt-card').forEach((card) => {
          card.dataset.navigating = 'false';
          card.classList.remove('is-touch-active');
        });
      });

      function setupHamburgerMenu() {
        const wrap = document.getElementById('menu-wrap');
        const toggle = document.getElementById('menu-toggle');
        if (!wrap || !toggle || toggle.dataset.menuInit) return;
        toggle.dataset.menuInit = 'true';

        function close() {
          wrap.classList.remove('is-open');
          toggle.setAttribute('aria-expanded', 'false');
        }
        function open() {
          wrap.classList.add('is-open');
          toggle.setAttribute('aria-expanded', 'true');
        }

        toggle.addEventListener('click', (e) => {
          e.stopPropagation();
          wrap.classList.contains('is-open') ? close() : open();
        });
        document.addEventListener('click', (e) => {
          if (wrap.classList.contains('is-open') && !wrap.contains(e.target)) close();
        });
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape') close();
        });
      }

      function setupAll() {
        setupVideoControls();
        if (ANTI_COPY_ENABLED) setupAntiCopy();
        setupTiltCards();
        setupParallaxOnlyCards();
        setupScrollParallax();
        setupTouchCardFeedback();
        setupHamburgerMenu();
      }

      document.addEventListener('astro:page-load', setupAll);
      document.addEventListener('DOMContentLoaded', setupAll);
    </script>
  </body>
</html>
